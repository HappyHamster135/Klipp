                                                <FontIcon Glyph="&#xE777;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Size"
                                                   Foreground="{StaticResource KlippTextPrimaryBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
