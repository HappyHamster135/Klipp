<UserControl
    x:Class="Klipp.Desktop.Controls.SafeClipEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Klipp.Desktop.Controls"
    xmlns:branding="using:Klipp.Core.Branding"
    xmlns:local="using:Klipp.Desktop"
    xmlns:models="using:Klipp.Desktop.Models"
    xmlns:services="using:Klipp.Desktop.Services"
    IsTabStop="True"
    KeyDown="OnEditorKeyDown">

    <UserControl.Resources>
        <Style x:Key="EditorToolButtonStyle" TargetType="Button" BasedOn="{StaticResource KlippBaseButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource KlippBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Padding="16,8"
              Background="{StaticResource KlippSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="OnBackClicked"
                    Background="Transparent"
                    BorderBrush="{StaticResource KlippBorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource KlippTextSecondaryBrush}"
                    Padding="12,7,14,7"
                    CornerRadius="4"
                    FontSize="13" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14" />
                    <TextBlock Text="Library" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1"
                        Margin="18,0"
                        VerticalAlignment="Center"
                        Spacing="2">
                <TextBox x:Name="TitleText"
                         Text="Editor"
                         TextChanged="OnProjectNameChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontSize="18"
                         FontWeight="SemiBold" />
                <TextBlock x:Name="ProjectStatusText"
                           Text="Autosave on"
                           Style="{StaticResource KlippBodyTextSecondary}"
                           FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Click="OnSaveNamedProjectClicked"
                        Padding="14,8"
                        CornerRadius="4"
                        FontSize="13">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="Save project" />
                    </StackPanel>
                </Button>
                <Button Click="OnExportClicked"
                        Background="{StaticResource KlippAccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="18,8"
                        CornerRadius="4"
                        FontSize="13"
                        FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE74E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="EditorWorkspaceRoot"
              Grid.Row="1"
              Padding="16"
              ColumnSpacing="12"
              SizeChanged="OnEditorWorkspaceSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="WorkspaceInspectorColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1"
                    Background="{StaticResource KlippBackgroundBrush}"
                    BorderBrush="{StaticResource KlippBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource KlippRadiusMd}">
                <Grid x:Name="PreviewWorkspace"
                      Background="{StaticResource KlippBackgroundBrush}"
                      SizeChanged="OnPreviewWorkspaceSizeChanged"
                      PointerWheelChanged="OnPreviewWorkspacePointerWheelChanged"
                      PointerMoved="OnTimelineFxPreviewMoved" PointerReleased="OnTimelineFxPreviewReleased"
                      PointerCanceled="OnTimelineFxPreviewCanceled" PointerCaptureLost="OnTimelineFxPreviewCanceled"
                      AutomationProperties.Name="Editor preview canvas"
                      AutomationProperties.HelpText="Scroll to zoom the canvas. The black area is included in the export.">
                <Canvas x:Name="PreviewCanvasViewport">
                <Grid x:Name="PreviewSurface"
                      Width="1280"
                      Height="720"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="Black"
                      Tapped="OnPreviewTapped"
                      SizeChanged="OnPreviewSurfaceSizeChanged"
                      PointerPressed="OnPreviewSurfacePointerPressed"
                      PointerMoved="OnPreviewSurfacePointerMoved"
                      PointerReleased="OnPreviewSurfacePointerReleased"
                      PointerCanceled="OnPreviewSurfacePointerCanceled"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="PreviewStageTransform" />
                    </Grid.RenderTransform>
                    <Grid x:Name="PreviewMediaHost"
                          IsHitTestVisible="True"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="PreviewMediaTransform" />
                        </Grid.RenderTransform>

                        <Grid>
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="PrimaryTransitionMotionTransform" />
                            </Grid.RenderTransform>
                        <Grid x:Name="PrimaryPreviewHost"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="PrimaryPreviewTransform" />
                            </Grid.RenderTransform>
                            <Grid x:Name="PrimaryPreviewCropHost">
                                <Grid.Clip>
                                    <RectangleGeometry x:Name="PrimaryPreviewClipGeometry" />
                                </Grid.Clip>
                                <MediaPlayerElement x:Name="NativePreviewPlayer"
                                                    AutoPlay="False"
                                                    AreTransportControlsEnabled="False"
                                                    Stretch="Uniform"
                                                    IsHitTestVisible="False" />
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform"
                                       Opacity="0" />
                            </Grid>
                            <Grid x:Name="PrimaryEffectPreviewHost"
                                  IsHitTestVisible="False" />
                        </Grid>
                        </Grid>

                        <Grid x:Name="TransitionPreviewRevealHost"
                              Visibility="Collapsed"
                              IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="IncomingTransitionMotionTransform" />
                            </Grid.RenderTransform>
                            <Grid.Clip>
                                <RectangleGeometry x:Name="TransitionPreviewRevealGeometry" />
                            </Grid.Clip>
                            <Grid x:Name="TransitionPreviewShapeHost" IsHitTestVisible="False">
                            <Grid x:Name="TransitionPreviewHost"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="TransitionPreviewTransform" />
                                </Grid.RenderTransform>
                                <Grid x:Name="TransitionPreviewCropHost">
                                    <Grid.Clip>
                                        <RectangleGeometry x:Name="TransitionPreviewClipGeometry" />
                                    </Grid.Clip>
                                    <MediaPlayerElement x:Name="TransitionPreviewPlayer"
                                                        AutoPlay="False"
                                                        AreTransportControlsEnabled="False"
                                                        Stretch="Uniform"
                                                        IsHitTestVisible="False" />
                                </Grid>
                                <Grid x:Name="TransitionEffectPreviewHost"
                                      IsHitTestVisible="False" />
                            </Grid>
                            </Grid>
                        </Grid>

                        <Border x:Name="TransitionWhiteDipOverlay" Background="White" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Grid x:Name="AdditionalVideoTrackPreviewCanvas" IsHitTestVisible="False" />
                        <Grid x:Name="OverlayTrackRevealHost" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="OverlayTrackMotionTransform" />
                            </Grid.RenderTransform>
                            <Grid.Clip>
                                <RectangleGeometry x:Name="OverlayTrackRevealGeometry" />
                            </Grid.Clip>
                            <Grid x:Name="OverlayTrackShapeHost" IsHitTestVisible="False">
                        <Grid x:Name="OverlayPreviewHost"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="OverlayPreviewTransform" />
                            </Grid.RenderTransform>
                            <Grid x:Name="OverlayPreviewCropHost">
                                <Grid.Clip>
                                    <RectangleGeometry x:Name="OverlayPreviewClipGeometry" />
                                </Grid.Clip>
                                <MediaPlayerElement x:Name="OverlayPreviewPlayer"
                                                    AutoPlay="False"
                                                    AreTransportControlsEnabled="False"
                                                    Stretch="Uniform"
                                                    IsHitTestVisible="False" />
                            </Grid>
                            <Grid x:Name="OverlayEffectPreviewHost"
                                  IsHitTestVisible="False" />
                        </Grid>
                            </Grid>
                        </Grid>
                        <Border x:Name="OverlayTrackDipOverlay" Visibility="Collapsed" IsHitTestVisible="False" />

                        <Grid x:Name="VideoTransformFrame"
                              Visibility="Collapsed"
                              IsHitTestVisible="True"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              AutomationProperties.Name="Video transform controls"
                              PointerPressed="OnVideoFramePointerPressed"
                              PointerMoved="OnVideoFramePointerMoved"
                              PointerReleased="OnVideoFramePointerReleased"
                              PointerCanceled="OnVideoFramePointerCanceled">
                            <Border x:Name="VideoTransformOutline"
                                    BorderBrush="#B3FFFFFF"
                                    BorderThickness="1"
                                    IsHitTestVisible="False" />
                            <Border Width="14"
                                    Height="14"
                                    Tag="nw"
                                    Background="#F2FFFFFF"
                                    BorderBrush="#CC171A1D"
                                    BorderThickness="1"
                                    CornerRadius="1"
                                    AutomationProperties.Name="Resize video from top left"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    PointerPressed="OnVideoResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="14"
                                    Height="14"
                                    Tag="ne"
                                    Background="#F2FFFFFF"
                                    BorderBrush="#CC171A1D"
                                    BorderThickness="1"
                                    CornerRadius="1"
                                    AutomationProperties.Name="Resize video from top right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    PointerPressed="OnVideoResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="14"
                                    Height="14"
                                    Tag="sw"
                                    Background="#F2FFFFFF"
                                    BorderBrush="#CC171A1D"
                                    BorderThickness="1"
                                    CornerRadius="1"
                                    AutomationProperties.Name="Resize video from bottom left"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    PointerPressed="OnVideoResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="14"
                                    Height="14"
                                    Tag="se"
                                    Background="#F2FFFFFF"
                                    BorderBrush="#CC171A1D"
                                    BorderThickness="1"
                                    CornerRadius="1"
                                    AutomationProperties.Name="Resize video from bottom right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    PointerPressed="OnVideoResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="PreviewFallback"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <Border Width="92"
                                Height="92"
                                CornerRadius="46"
                                Background="{StaticResource KlippAccentBrush}">
                            <TextBlock Text="&#xE768;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="42"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Preview laddas..."
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource KlippTextSecondaryBrush}" />
                    </StackPanel>

                    <Border x:Name="VfxTintOverlay"
                            Background="Transparent"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <Border x:Name="ClipBrightnessPreviewOverlay"
                            Background="Transparent"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <Border x:Name="ClipTemperaturePreviewOverlay"
                            Background="Transparent"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <Border x:Name="ClipHuePreviewOverlay"
                            Background="Transparent"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <Border x:Name="ClipVignettePreviewOverlay"
                            BorderBrush="Black"
                            BorderThickness="0"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <Grid x:Name="ElementLetterboxOverlay"
                          Visibility="Collapsed"
                          IsHitTestVisible="False">
                        <Border Height="46"
                                VerticalAlignment="Top"
                                Background="Black" />
                        <Border Height="46"
                                VerticalAlignment="Bottom"
                                Background="Black" />
                    </Grid>

                    <Border x:Name="ElementFocusFrame"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Margin="70,54"
                            BorderBrush="White"
                            BorderThickness="3"
                            CornerRadius="4"
                            Opacity="0.82" />

                    <Grid x:Name="ElementCenterMarker"
                          Visibility="Collapsed"
                          IsHitTestVisible="False"
                          Width="72"
                          Height="72"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0.86">
                        <Border Width="56"
                                Height="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="2" />
                        <Border Width="4"
                                Height="56"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="2" />
                    </Grid>

                    <Canvas x:Name="GraphicOverlayCanvas"
                            IsHitTestVisible="True" />

                    <Canvas x:Name="ExtraTextOverlayCanvas"
                            IsHitTestVisible="False" />

                    <Border x:Name="TextOverlayBackground"
                            Visibility="Collapsed"
                            IsHitTestVisible="True"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0"
                            Padding="14"
                            CornerRadius="4"
                            Background="#00000000"
                            BorderBrush="#BFA970FF"
                            BorderThickness="1.5"
                            RenderTransformOrigin="0.5,0.5"
                            SizeChanged="OnTextOverlaySizeChanged"
                            PointerPressed="OnTextOverlayPointerPressed"
                            PointerMoved="OnTextOverlayPointerMoved"
                            PointerReleased="OnTextOverlayPointerReleased"
                            PointerCanceled="OnTextOverlayPointerCanceled"
                            Tapped="OnOverlayTapped">
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="TextOverlayTransform" />
                        </Border.RenderTransform>
                        <Grid>
                            <Border x:Name="TextOverlayStyleBox"
                                    Margin="8"
                                    Padding="12,6"
                                    CornerRadius="4"
                                    Background="#00000000">
                                <TextBlock x:Name="TextOverlayPreview"
                                           Text=""
                                           MinWidth="48"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="64"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                            <Border Width="12"
                                    Height="12"
                                    Tag="nw"
                                    Background="White"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    PointerPressed="OnTextResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="12"
                                    Height="12"
                                    Tag="ne"
                                    Background="White"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    PointerPressed="OnTextResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="12"
                                    Height="12"
                                    Tag="sw"
                                    Background="White"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    PointerPressed="OnTextResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="12"
                                    Height="12"
                                    Tag="se"
                                    Background="White"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    PointerPressed="OnTextResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="10"
                                    Height="34"
                                    Tag="w"
                                    Background="#F2FFFFFF"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    PointerPressed="OnTextResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="10"
                                    Height="34"
                                    Tag="e"
                                    Background="#F2FFFFFF"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    PointerPressed="OnTextResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                        </Grid>
                    </Border>

                    <Border x:Name="SubtitleOverlayBackground"
                            Visibility="Collapsed"
                            IsHitTestVisible="True"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0"
                            Padding="14"
                            CornerRadius="4"
                            Background="#00000000"
                            BorderBrush="#BFA970FF"
                            BorderThickness="1.5"
                            SizeChanged="OnSubtitleOverlaySizeChanged"
                            PointerPressed="OnSubtitleOverlayPointerPressed"
                            PointerMoved="OnSubtitleOverlayPointerMoved"
                            PointerReleased="OnSubtitleOverlayPointerReleased"
                            PointerCanceled="OnSubtitleOverlayPointerCanceled"
                            Tapped="OnOverlayTapped">
                        <Grid>
                            <Border x:Name="SubtitleOverlayStyleBox"
                                    Margin="8"
                                    Padding="12,6"
                                    CornerRadius="4"
                                    Background="#A6000000">
                                <TextBlock x:Name="SubtitleOverlayPreview"
                                           Text=""
                                           MinWidth="48"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="42"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                            <Border Width="12"
                                    Height="12"
                                    Tag="nw"
                                    Background="White"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    PointerPressed="OnSubtitleResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="12"
                                    Height="12"
                                    Tag="ne"
                                    Background="White"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    PointerPressed="OnSubtitleResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="12"
                                    Height="12"
                                    Tag="sw"
                                    Background="White"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    PointerPressed="OnSubtitleResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="12"
                                    Height="12"
                                    Tag="se"
                                    Background="White"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    PointerPressed="OnSubtitleResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="10"
                                    Height="34"
                                    Tag="w"
                                    Background="#F2FFFFFF"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    PointerPressed="OnSubtitleResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                            <Border Width="10"
                                    Height="34"
                                    Tag="e"
                                    Background="#F2FFFFFF"
                                    BorderBrush="#A970FF"
                                    BorderThickness="2"
                                    CornerRadius="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    PointerPressed="OnSubtitleResizeHandlePointerPressed"
                                    PointerMoved="OnResizeHandlePointerMoved"
                                    PointerReleased="OnResizeHandlePointerReleased"
                                    PointerCanceled="OnResizeHandlePointerCanceled" />
                        </Grid>
                    </Border>

                    <Border x:Name="FadePreviewOverlay"
                            Visibility="Collapsed"
                            Background="Black"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    </Grid>
                </Canvas>

                    <Grid x:Name="SafeAreaGuidesOverlay"
                          Visibility="Collapsed"
                          IsHitTestVisible="False">
                        <Border x:Name="ActionSafeAreaBorder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#80FFFFFF"
                                BorderThickness="2" />
                        <Border x:Name="TitleSafeAreaBorder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#BFA970FF"
                                BorderThickness="2" />
                    </Grid>

                    <Canvas x:Name="TimelineFxPreviewAdorner" Visibility="Collapsed"
                            AutomationProperties.Name="Selected FX area controls" />

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="16"
                            Padding="6"
                            Background="{StaticResource KlippSurfaceBrush}"
                            BorderBrush="{StaticResource KlippBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Click="OnPreviewZoomOutClicked"
                                    AutomationProperties.Name="Zoom out preview canvas"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Content="-" />
                            <Button Grid.Column="1"
                                    Click="OnPreviewZoomFitClicked"
                                    AutomationProperties.Name="Fit preview canvas"
                                    MinWidth="58"
                                    Height="32"
                                    Padding="8,0" HorizontalAlignment="Stretch">
                                <TextBlock x:Name="PreviewZoomOverlayText"
                                           Text="100%"
                                           FontFamily="{StaticResource KlippFontFamilyMono}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Button>
                            <Button Grid.Column="2"
                                    Click="OnPreviewZoomInClicked"
                                    AutomationProperties.Name="Zoom in preview canvas"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Content="+" />
                        </Grid>
                    </Border>
                    <Button x:Name="QuickPreviewQualityButton"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                            Padding="10,8" CornerRadius="4" Background="{StaticResource KlippSurfaceBrush}"
                            BorderBrush="{StaticResource KlippBorderBrush}" BorderThickness="1"
                            AutomationProperties.Name="Preview playback quality"
                            ToolTipService.ToolTip="Choose preview quality. Export always uses original media.">
                        <Button.Content>
                            <TextBlock x:Name="QuickPreviewQualityText" Text="Preview · Original" FontSize="11" />
                        </Button.Content>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Original quality" Click="OnPreviewOriginalClicked" />
                                <MenuFlyoutItem Text="Smooth · 720p" Click="OnPreview720pClicked" />
