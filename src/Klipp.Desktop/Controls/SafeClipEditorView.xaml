                                            <Button Width="32" Height="32" Padding="0" Background="#EEFF26" BorderBrush="#66FFFFFF" Tag="#EEFF26" Click="OnTextColorSwatchClicked" AutomationProperties.Name="Yellow text color" ToolTipService.ToolTip="Highlight yellow" />
                                            <Button Width="32" Height="32" Padding="0" Background="#B0FF50" BorderBrush="#66FFFFFF" Tag="#B0FF50" Click="OnTextColorSwatchClicked" AutomationProperties.Name="Lime text color" ToolTipService.ToolTip="Lime" />
                                            <Button Width="32" Height="32" Padding="0" Background="#4CEBFF" BorderBrush="#66FFFFFF" Tag="#4CEBFF" Click="OnTextColorSwatchClicked" AutomationProperties.Name="Cyan text color" ToolTipService.ToolTip="Cyan" />
                                            <Button Width="32" Height="32" Padding="0" Background="#A970FF" BorderBrush="#66FFFFFF" Tag="#A970FF" Click="OnTextColorSwatchClicked" AutomationProperties.Name="Purple text color" ToolTipService.ToolTip="Purple" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
