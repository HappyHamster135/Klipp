                                                   Text="64 px"
                                                   FontFamily="{StaticResource KlippFontFamilyMono}"
                                                   Foreground="{StaticResource KlippAccentBrush}" />
                                    </Grid>
                                    <Slider x:Name="TextSizeSlider"
                                            ValueChanged="OnTextSizeChanged" />
                                </StackPanel>

                                <Border Background="{StaticResource KlippSurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource KlippBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Opacity"
                                                       Foreground="{StaticResource KlippTextPrimaryBrush}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="TextOpacityValueText"
                                                       Grid.Column="1"
                                                       Text="100%"
                                                       FontFamily="{StaticResource KlippFontFamilyMono}"
                                                       Foreground="{StaticResource KlippAccentBrush}" />
                                        </Grid>
                                            <Slider x:Name="TextOpacitySlider"
                                                Minimum="0"
                                                Maximum="100"
                                                ValueChanged="OnTextOpacityChanged" />
                                        <Rectangle Height="1"
                                                   Fill="{StaticResource KlippBorderBrush}"
                                                   Margin="0,2" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Motion keyframes"
                                                       Foreground="{StaticResource KlippTextPrimaryBrush}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="TextKeyframeCountText"
                                                       Grid.Column="1"
                                                       Text="0"
                                                       FontFamily="{StaticResource KlippFontFamilyMono}"
                                                       Foreground="{StaticResource KlippAccentBrush}" />
                                        </Grid>
                                        <TextBlock x:Name="TextKeyframeStatusText"
                                                   Text="Animate position, size and opacity from the playhead."
                                                   Style="{StaticResource KlippBodyTextSecondary}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="TextPreviousKeyframeButton"
                                                    AutomationProperties.Name="Previous text keyframe"
                                                    Width="40"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="OnPreviousTextKeyframeClicked"
                                                    ToolTipService.ToolTip="Previous text keyframe">
                                                <FontIcon Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                            <Button x:Name="TextAddKeyframeButton"
                                                    AutomationProperties.Name="Add or update text keyframe"
                                                    Grid.Column="1"
                                                    Height="32"
                                                    HorizontalAlignment="Stretch"
                                                    Click="OnAddTextKeyframeClicked">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                                    <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" />
                                                    <TextBlock x:Name="TextAddKeyframeButtonText" Text="Add keyframe" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="TextNextKeyframeButton"
                                                    AutomationProperties.Name="Next text keyframe"
                                                    Grid.Column="2"
                                                    Width="40"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="OnNextTextKeyframeClicked"
                                                    ToolTipService.ToolTip="Next text keyframe">
                                                <FontIcon Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                            <Button x:Name="TextDeleteKeyframeButton"
                                                    AutomationProperties.Name="Delete text keyframe"
                                                    Grid.Column="3"
                                                    Width="40"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="OnDeleteTextKeyframeClicked"
                                                    ToolTipService.ToolTip="Delete text keyframe">
                                                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                        </Grid>
                                        <ComboBox x:Name="TextKeyframeEasingComboBox"
                                                  Header="Interpolation to this keyframe"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnTextKeyframeEasingChanged">
                                            <ComboBoxItem Content="Linear" Tag="linear" />
                                            <ComboBoxItem Content="Ease in" Tag="ease-in" />
                                            <ComboBoxItem Content="Ease out" Tag="ease-out" />
                                            <ComboBoxItem Content="Ease in and out" Tag="ease-in-out" />
                                            <ComboBoxItem Content="Hold" Tag="hold" />
                                        </ComboBox>
                                        <Button x:Name="ClearTextKeyframesButton"
                                                HorizontalAlignment="Stretch"
                                                Click="OnClearTextKeyframesClicked"
                                                Content="Clear animation" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Canvas"
                                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Drag text on the video. Position and resizing snap to an 8 px grid."
                                               Style="{StaticResource KlippBodyTextSecondary}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <Grid Visibility="Collapsed"
                                          ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="TextPositionTopButton"
                                                Grid.Column="0"
                                                Click="OnTextPositionTopClicked"
                                                Content="Top"  HorizontalAlignment="Stretch" />
                                        <Button x:Name="TextPositionCenterButton"
                                                Grid.Column="1"
                                                Click="OnTextPositionCenterClicked"
                                                Content="Center"  HorizontalAlignment="Stretch" />
                                        <Button x:Name="TextPositionBottomButton"
                                                Grid.Column="2"
                                                Click="OnTextPositionBottomClicked"
                                                Content="Bottom"  HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <TextBlock Text="Animation"
                                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button x:Name="TextAnimationNoneButton"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Click="OnTextAnimationNoneClicked"
                                                Padding="8" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="5">
                                                <Border Height="34"
                                                        CornerRadius="6"
                                                        Background="#101015">
                                                    <TextBlock Text="A"
                                                               Foreground="White"
                                                               FontSize="19"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="None"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="TextAnimationFadeButton"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Click="OnTextAnimationFadeClicked"
                                                Padding="8" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="5">
                                                <Grid Height="34">
                                                    <Border CornerRadius="6"
                                                            Background="#101015" />
                                                    <TextBlock Text="A"
                                                               Foreground="#88FFFFFF"
                                                               FontSize="19"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="Fade"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="TextAnimationPopButton"
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Click="OnTextAnimationPopClicked"
                                                Padding="8" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="5">
                                                <Border Height="34"
                                                        CornerRadius="6"
                                                        Background="#101015">
                                                    <TextBlock Text="A"
                                                               Foreground="#B0FF50"
                                                               FontSize="24"
                                                               FontWeight="Black"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="Pop"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="TextAnimationSlideUpButton"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Click="OnTextAnimationSlideUpClicked"
                                                Padding="8" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="5">
                                                <Grid Height="34">
                                                    <Border CornerRadius="6"
                                                            Background="#101015" />
                                                    <TextBlock Text="A"
                                                               Foreground="White"
                                                               FontSize="19"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="0,-7,0,0" />
                                                    <TextBlock Text="&#xE74A;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="#A970FF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Bottom"
                                                               Margin="0,0,0,2" />
                                                </Grid>
                                                <TextBlock Text="Up"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="TextAnimationSlideLeftButton"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Click="OnTextAnimationSlideLeftClicked"
                                                Padding="8" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="5">
                                                <Grid Height="34">
                                                    <Border CornerRadius="6"
                                                            Background="#101015" />
                                                    <TextBlock Text="A"
                                                               Foreground="White"
                                                               FontSize="19"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="-9,0,0,0" />
                                                    <TextBlock Text="&#xE72B;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="#A970FF"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                </Grid>
                                                <TextBlock Text="Left"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="TextAnimationTypeButton"
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Click="OnTextAnimationTypeClicked"
                                                Padding="8" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="5">
                                                <Border Height="34"
                                                        CornerRadius="6"
                                                        Background="#101015">
                                                    <TextBlock Text="Ty|"
                                                               Foreground="White"
                                                               FontFamily="Consolas"
                                                               FontSize="18"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="Type"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="VfxPanel" Visibility="Collapsed" Spacing="8">
                                <StackPanel Spacing="0">
                                    <TextBlock Text="Effects" Style="{StaticResource KlippHeadingMedium}" />
                                    <TextBlock Text="Choose an FX to add it to the timeline. Trim its timing and choose where it appears." Style="{StaticResource KlippBodyTextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border x:Name="TimelineFxInspector" Visibility="Collapsed" Padding="10" CornerRadius="4"
                                        Background="{StaticResource KlippSurfaceElevatedBrush}" BorderBrush="{StaticResource KlippBorderBrush}"
                                        BorderThickness="1" Unloaded="OnTimelineFxInspectorUnloaded">
                                    <StackPanel x:Name="TimelineFxControls" Spacing="8">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock x:Name="TimelineFxNameText" Text="Timeline FX" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TimelineFxTargetText" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{StaticResource KlippTextMutedBrush}"/></StackPanel>
                                            <CheckBox x:Name="TimelineFxEnabledCheckBox" Grid.Column="1" Content="On" MinHeight="28"
                                                      Checked="OnTimelineFxEnabledChanged" Unchecked="OnTimelineFxEnabledChanged" AutomationProperties.Name="Enable selected timeline FX"/>
                                        </Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Amount" FontSize="12"/><TextBlock x:Name="TimelineFxAmountText" Grid.Column="1" Text="100%" Style="{StaticResource KlippMono}"/>
                                        </Grid>
                                        <Slider x:Name="TimelineFxAmountSlider" Minimum="0" Maximum="100" Value="100" StepFrequency="1"
                                                ValueChanged="OnTimelineFxAmountChanged" AutomationProperties.Name="Timeline FX amount"/>
                                        <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="TimelineFxStartBox" Header="Start (s)" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="OnTimelineFxTimeChanged" AutomationProperties.Name="FX start seconds"/>
                                            <NumberBox x:Name="TimelineFxEndBox" Grid.Column="1" Header="End (s)" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="OnTimelineFxTimeChanged" AutomationProperties.Name="FX end seconds"/>
                                        </Grid>
                                        <Button x:Name="TimelineFxPreviewButton" Content="Show FX in preview" HorizontalAlignment="Stretch" Height="28" FontSize="11"
                                                Click="OnShowTimelineFxPreviewClicked" ToolTipService.ToolTip="Place the playhead inside this FX to edit its area on the video"/>
                                        <TextBlock Text="Affected area" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <ComboBox x:Name="TimelineFxAreaPresetBox" HorizontalAlignment="Stretch" SelectionChanged="OnTimelineFxAreaPresetChanged" AutomationProperties.Name="FX affected area">
                                            <ComboBoxItem Content="Whole picture" Tag="full"/><ComboBoxItem Content="Center" Tag="center"/>
                                            <ComboBoxItem Content="Left half" Tag="left"/><ComboBoxItem Content="Right half" Tag="right"/>
                                            <ComboBoxItem Content="Top half" Tag="top"/><ComboBoxItem Content="Bottom half" Tag="bottom"/>
                                            <ComboBoxItem Content="Custom area" Tag="custom"/>
                                        </ComboBox>
                                        <ComboBox x:Name="TimelineFxShapeBox" HorizontalAlignment="Stretch" SelectionChanged="OnTimelineFxShapeChanged" AutomationProperties.Name="FX area shape">
                                            <ComboBoxItem Content="Rectangle"/><ComboBoxItem Content="Oval"/>
                                        </ComboBox>
                                        <Grid>
                                            <TextBlock Text="Soft edge" FontSize="12"/>
                                            <TextBlock x:Name="TimelineFxFeatherText" Text="0%" HorizontalAlignment="Right" Style="{StaticResource KlippMono}"/>
                                        </Grid>
                                        <Slider x:Name="TimelineFxFeatherSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                                ValueChanged="OnTimelineFxFeatherChanged" AutomationProperties.Name="FX edge softness"
                                                ToolTipService.ToolTip="Fade the effect inward from its edge, keeping the surrounding picture unchanged"/>
                                        <CheckBox x:Name="TimelineFxAnimateCheckBox" Content="Animate area" MinHeight="28"
                                                  Checked="OnTimelineFxAnimateChanged" Unchecked="OnTimelineFxAnimateChanged"
                                                  AutomationProperties.Name="Animate the FX area with keyframes"/>
                                        <StackPanel x:Name="TimelineFxMotionControls" Spacing="6" Visibility="Collapsed">
                                            <TextBlock Text="Move the playhead, then move or resize the area. Its position blends between keyframes."
                                                       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource KlippTextSecondaryBrush}"/>
                                            <TextBlock x:Name="TimelineFxKeyframeStatusText" FontSize="10" Foreground="{StaticResource KlippTextMutedBrush}"/>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                                <Button x:Name="TimelineFxPreviousKeyframeButton" Width="32" Height="32" Padding="0" Click="OnTimelineFxPreviousKeyframeClicked"
                                                        AutomationProperties.Name="Previous FX area keyframe" ToolTipService.ToolTip="Previous area keyframe"><FontIcon Glyph="&#xE892;" FontSize="12"/></Button>
                                                <Button x:Name="TimelineFxAddKeyframeButton" Grid.Column="1" Height="32" HorizontalAlignment="Stretch" Padding="6,0"
                                                        Click="OnTimelineFxAddKeyframeClicked" AutomationProperties.Name="Add or update FX area keyframe">
                                                    <TextBlock x:Name="TimelineFxAddKeyframeText" Text="Add keyframe" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                                <Button x:Name="TimelineFxNextKeyframeButton" Grid.Column="2" Width="32" Height="32" Padding="0" Click="OnTimelineFxNextKeyframeClicked"
                                                        AutomationProperties.Name="Next FX area keyframe" ToolTipService.ToolTip="Next area keyframe"><FontIcon Glyph="&#xE893;" FontSize="12"/></Button>
                                                <Button x:Name="TimelineFxRemoveKeyframeButton" Grid.Column="3" Width="32" Height="32" Padding="0" Click="OnTimelineFxRemoveKeyframeClicked"
                                                        AutomationProperties.Name="Remove current FX area keyframe" ToolTipService.ToolTip="Remove this area keyframe"><FontIcon Glyph="&#xE74D;" FontSize="12"/></Button>
                                            </Grid>
                                        </StackPanel>
                                        <Button Content="Use current frame" Height="28" FontSize="11" HorizontalAlignment="Stretch" Click="OnRefreshTimelineFxFrameClicked"
                                                ToolTipService.ToolTip="Load the source picture at the playhead for drawing the FX area"/>
                                        <Border Background="#101214" BorderBrush="{StaticResource KlippBorderBrush}" BorderThickness="1" Padding="2" CornerRadius="3">
                                            <Canvas x:Name="TimelineFxAreaCanvas" Width="276" Height="155.25" HorizontalAlignment="Center" Background="Transparent"
                                                    PointerPressed="OnTimelineFxAreaPressed" PointerMoved="OnTimelineFxAreaMoved" PointerReleased="OnTimelineFxAreaReleased"
                                                    PointerCanceled="OnTimelineFxAreaCanceled" PointerCaptureLost="OnTimelineFxAreaCanceled"
                                                    AutomationProperties.Name="Draw the area affected by this FX" AutomationProperties.HelpText="Drag across the source picture to draw an affected area. Percentage controls are available below.">
                                                <Image x:Name="TimelineFxSourceImage" Width="276" Height="155.25" Stretch="Fill" IsHitTestVisible="False"/>
                                                <Rectangle x:Name="TimelineFxAreaRectangle" Width="276" Height="155.25" Stroke="{StaticResource KlippAccentBrush}" StrokeThickness="2" Fill="#2289B8EA" IsHitTestVisible="False"/>
                                                <Ellipse x:Name="TimelineFxAreaEllipse" Visibility="Collapsed" Stroke="{StaticResource KlippAccentBrush}" StrokeThickness="2" Fill="#2289B8EA" IsHitTestVisible="False"/>
                                            </Canvas>
                                        </Border>
                                        <TextBlock Text="Drag the area or its corners on the video. You can also draw an area on this source picture." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource KlippTextMutedBrush}"/>
                                        <Expander Header="Precise area (%)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnSpacing="6" RowSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <NumberBox x:Name="TimelineFxXBox" Header="Left" Minimum="0" Maximum="98" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnTimelineFxAreaNumberChanged"/>
                                                <NumberBox x:Name="TimelineFxYBox" Grid.Column="1" Header="Top" Minimum="0" Maximum="98" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnTimelineFxAreaNumberChanged"/>
                                                <NumberBox x:Name="TimelineFxWidthBox" Grid.Row="1" Header="Width" Minimum="2" Maximum="100" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnTimelineFxAreaNumberChanged"/>
                                                <NumberBox x:Name="TimelineFxHeightBox" Grid.Row="1" Grid.Column="1" Header="Height" Minimum="2" Maximum="100" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnTimelineFxAreaNumberChanged"/>
                                            </Grid>
                                        </Expander>
                                        <Button x:Name="TimelineFxRemoveButton" Content="Remove FX" HorizontalAlignment="Stretch" Height="32" Click="OnRemoveTimelineFxClicked"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="LookSelectionHintText" Text="Select a video clip, or drag a look onto one."
                                           FontSize="11" Foreground="{StaticResource KlippTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="ShowSelectedEffectClipButton" Content="Show selected clip" Height="28" FontSize="11"
                                        Visibility="Collapsed" HorizontalAlignment="Stretch" Click="OnShowSelectedEffectClipClicked"
                                        ToolTipService.ToolTip="Move the playhead into the selected clip to see its effects" />
                                <TextBox x:Name="LookSearchBox" PlaceholderText="Search looks" Height="32"
                                         TextChanged="OnLookSearchChanged" AutomationProperties.Name="Search looks" />
                                <Grid x:Name="LookPaletteCategories" ColumnSpacing="6" Loaded="OnLookPaletteLoaded">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button x:Name="AllLooksCategoryButton" Tag="all" Click="OnLookPaletteCategoryClicked" Content="All" Height="32" HorizontalAlignment="Stretch" />
                                    <Button x:Name="ColorLooksCategoryButton" Grid.Column="1" Tag="color" Click="OnLookPaletteCategoryClicked" Content="Color" Height="32" HorizontalAlignment="Stretch" />
                                    <Button x:Name="FinishLooksCategoryButton" Grid.Column="2" Tag="finish" Click="OnLookPaletteCategoryClicked" Content="Finish" Height="32" HorizontalAlignment="Stretch" />
                                </Grid>
                                <ScrollViewer MaxHeight="208" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              AutomationProperties.Name="Draggable clip look presets">
                                    <Grid>
                                        <Grid x:Name="LookPresetGrid" ColumnSpacing="6" RowSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        </Grid>
                                        <TextBlock x:Name="LookSearchEmptyText" Text="No looks found. Try another search." Visibility="Collapsed"
                                                   Margin="4,12" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource KlippTextMutedBrush}" />
                                    </Grid>
                                </ScrollViewer>
                                <TextBlock x:Name="LookBrowserCountText" Text="20 looks" FontSize="10" Foreground="{StaticResource KlippTextMutedBrush}" />
                                <StackPanel x:Name="ClipEffectsControls" Spacing="4">

                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="QuickClipLookNameText" Text="None" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="Amount" Style="{StaticResource KlippBodyTextSecondary}" /><TextBlock x:Name="QuickClipFilterStrengthValueText" Text="100%" Style="{StaticResource KlippMono}" /></StackPanel>
                                    </Grid>
                                    <Slider x:Name="QuickClipFilterStrengthSlider" Minimum="0" Maximum="100"
                                            ValueChanged="OnQuickClipFilterStrengthChanged" AutomationProperties.Name="Selected clip effect amount"
                                            ToolTipService.ToolTip="Adjust the selected clip look and color effects" />
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="CompareOriginalButton" Grid.Column="0" Content="Compare original" Height="32" Padding="8,4"
                                                      Checked="OnOriginalPreviewToggled" Unchecked="OnOriginalPreviewToggled" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Compare clip with original" ToolTipService.ToolTip="Temporarily bypass clip color effects in the preview" />
                                        <Button Grid.Column="1" Click="OnResetClipLookClicked" Content="Remove look" Height="32" Padding="8,4"
                                                HorizontalAlignment="Stretch" ToolTipService.ToolTip="Remove the preset only. Your color adjustments and LUT are kept." />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="CopyClipLookButton"
                                                Grid.Column="0" Height="32" Padding="8,4"
                                                HorizontalAlignment="Stretch" Content="Copy look"
                                                Click="OnCopyClipLookClicked"
                                                ToolTipService.ToolTip="Copy the selected clip's static color grade, without motion, audio, timing or keyframes" />
                                        <Button x:Name="PasteClipLookButton"
                                                Grid.Column="1" Height="32" Padding="8,4"
                                                HorizontalAlignment="Stretch" Content="Paste look"
                                                Click="OnPasteClipLookClicked"
                                                ToolTipService.ToolTip="Paste the copied static color grade, keeping motion, audio, timing and keyframes" />
                                    </Grid>
                                    <Expander Header="Color adjustments" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="4">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Brightness" FontSize="12"/><TextBlock x:Name="QuickBrightnessValueText" Grid.Column="1" Text="0" Style="{StaticResource KlippMono}"/>
                                            </Grid>
                                            <Slider x:Name="QuickBrightnessSlider" Minimum="-100" Maximum="100" StepFrequency="1" ValueChanged="OnQuickColorAdjustmentChanged" AutomationProperties.Name="Quick brightness" />
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Contrast" FontSize="12"/><TextBlock x:Name="QuickContrastValueText" Grid.Column="1" Text="100%" Style="{StaticResource KlippMono}"/>
                                            </Grid>
                                            <Slider x:Name="QuickContrastSlider" StepFrequency="1" ValueChanged="OnQuickColorAdjustmentChanged" AutomationProperties.Name="Quick contrast" />
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Saturation" FontSize="12"/><TextBlock x:Name="QuickSaturationValueText" Grid.Column="1" Text="100%" Style="{StaticResource KlippMono}"/>
                                            </Grid>
                                            <Slider x:Name="QuickSaturationSlider" Minimum="0" Maximum="300" StepFrequency="1" ValueChanged="OnQuickColorAdjustmentChanged" AutomationProperties.Name="Quick saturation" />
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Temperature" FontSize="12"/><TextBlock x:Name="QuickTemperatureValueText" Grid.Column="1" Text="0" Style="{StaticResource KlippMono}"/>
                                            </Grid>
                                            <Slider x:Name="QuickTemperatureSlider" Minimum="-100" Maximum="100" StepFrequency="1" ValueChanged="OnQuickColorAdjustmentChanged" AutomationProperties.Name="Quick temperature" />
                                            <Button Content="Reset adjustments" Height="32" HorizontalAlignment="Stretch" Click="OnResetClipAdjustmentsClicked"
                                                    ToolTipService.ToolTip="Reset manual color and detail adjustments, keeping the preset, curve and LUT" />
                                            <Button Content="Advanced color controls" Height="32" HorizontalAlignment="Stretch" Click="OnOpenAdvancedColorClicked"
                                                    ToolTipService.ToolTip="Open curves, shadows, highlights, hue, detail and custom LUT controls" />
                                        </StackPanel>
                                    </Expander>
                                    <Button x:Name="ResetAllClipEffectsButton" Content="Reset all effects" Height="32" HorizontalAlignment="Stretch"
                                            Click="OnResetAllClipEffectsClicked" ToolTipService.ToolTip="Reset color, look, LUT, effect order and amount animation. Undo is available." />
                                    <Expander Header="My looks" HorizontalAlignment="Stretch" Loaded="OnEffectsWorkflowLoaded">
                                        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                            <ComboBox x:Name="UserLookComboBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Saved look preset" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Button x:Name="ApplyUserLookButton" Content="Apply" Height="32" HorizontalAlignment="Stretch" Click="OnApplyUserLookClicked" />
                                                <Button Grid.Column="1" Content="Save current" Height="32" HorizontalAlignment="Stretch" Click="OnSaveUserLookClicked" />
                                                <Button x:Name="DeleteUserLookButton" Grid.Column="2" Content="Remove" Height="32" Click="OnDeleteUserLookClicked" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="Effect stack" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                            <TextBlock Text="Applied from top to bottom. Turn off a stage to bypass it, or use the arrows to change its order."
                                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource KlippTextMutedBrush}" />
                                            <StackPanel x:Name="EffectStackRows" Spacing="4" />
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="Timing and stabilization" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Loaded="OnVideoProcessingPanelLoaded" Unloaded="OnVideoProcessingPanelUnloaded">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Vary speed through the clip or smooth camera shake. Audio keeps its own timing."
                                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource KlippTextMutedBrush}" />
                                            <CheckBox x:Name="VideoRampEnabledCheck" Content="Vary playback speed"
                                                      Checked="OnVideoProcessingOptionsChanged" Unchecked="OnVideoProcessingOptionsChanged" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <NumberBox x:Name="VideoRampStartSpeedBox" Header="Start ×" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.25" ValueChanged="OnVideoProcessingNumberChanged" />
                                                <NumberBox x:Name="VideoRampMiddleSpeedBox" Grid.Column="1" Header="Middle ×" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.25" ValueChanged="OnVideoProcessingNumberChanged" />
                                                <NumberBox x:Name="VideoRampEndSpeedBox" Grid.Column="2" Header="End ×" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.25" ValueChanged="OnVideoProcessingNumberChanged" />
                                            </Grid>
                                            <TextBlock Text="Stabilization strength" FontSize="12" />
                                            <Slider x:Name="VideoStabilizationStrengthSlider" Minimum="0" Maximum="100" Value="0" StepFrequency="5"
                                                    AutomationProperties.Name="Video stabilization strength" ValueChanged="OnVideoProcessingStrengthChanged" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Button x:Name="ApplyVideoProcessingButton" Content="Apply to video" Height="32" HorizontalAlignment="Stretch" Click="OnApplyVideoProcessingClicked" />
                                                <Button x:Name="ResetVideoProcessingButton" Grid.Column="1" Content="Reset" Height="32" Click="OnResetVideoProcessingClicked" />
                                            </Grid>
                                            <ProgressBar x:Name="VideoProcessingProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                            <Button x:Name="CancelVideoProcessingButton" Content="Cancel processing" Height="32" Visibility="Collapsed" Click="OnCancelVideoProcessingClicked" />
                                            <TextBlock x:Name="VideoProcessingStatusText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource KlippTextMutedBrush}" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock x:Name="ClipEffectPreviewStatusText"
                                               Style="{StaticResource KlippBodyTextSecondary}"
                                               FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />

                                </StackPanel>
                                <Expander Header="All looks" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <ComboBox x:Name="ClipLookComboBox" HorizontalAlignment="Stretch" SelectionChanged="OnClipLookChanged" AutomationProperties.Name="Selected clip look"><ComboBoxItem Tag="none" Content="None" />
<ComboBoxItem Tag="natural" Content="Natural" />
<ComboBoxItem Tag="matte" Content="Matte" />
<ComboBoxItem Tag="goldenhour" Content="Golden hour" />
<ComboBoxItem Tag="steel" Content="Steel" />
<ComboBoxItem Tag="glitch" Content="RGB split" />
<ComboBoxItem Tag="boost" Content="Clean" />
<ComboBoxItem Tag="film" Content="Film" />
<ComboBoxItem Tag="cinematic" Content="Cinema" />
<ComboBoxItem Tag="tealorange" Content="Teal and amber" />
<ComboBoxItem Tag="warm" Content="Warm" />
<ComboBoxItem Tag="cool" Content="Cool" />
<ComboBoxItem Tag="soft" Content="Soft contrast" />
<ComboBoxItem Tag="mono" Content="Monochrome" />
<ComboBoxItem Tag="noir" Content="Noir" />
<ComboBoxItem Tag="vintage" Content="Faded film" />
<ComboBoxItem Tag="vibrant" Content="Vivid" />
<ComboBoxItem Tag="dream" Content="Soft glow" />
<ComboBoxItem Tag="sharpen" Content="Detail" />
<ComboBoxItem Tag="blur" Content="Blur" />
<ComboBoxItem Tag="vignette" Content="Vignette" /></ComboBox>
                                </Expander>
                                <Expander x:Name="MotionToolsExpander" Header="Masks and tracking" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch" Loaded="OnMotionToolsLoaded" Unloaded="OnMotionToolsUnloaded">
                                    <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                        <TextBlock Text="Draw a polygon mask, or follow a textured subject by panning the video."
                                                   Style="{StaticResource KlippBodyTextSecondary}" FontSize="11" />
                                        <Button x:Name="LoadMotionFrameButton" Content="Load frame at playhead" Height="32"
                                                HorizontalAlignment="Stretch" Click="OnLoadMotionSourceFrameClicked" />
                                        <StackPanel x:Name="MotionFrameEditor" Spacing="8" Visibility="Collapsed">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button x:Name="DrawPolygonMaskButton" Content="Draw polygon" Height="32" HorizontalAlignment="Stretch" Click="OnDrawPolygonMaskClicked" />
                                                <Button x:Name="SelectTrackingRegionButton" Grid.Column="1" Content="Select subject" Height="32" HorizontalAlignment="Stretch" Click="OnSelectTrackingRegionClicked" />
                                            </Grid>
                                            <Border Background="#101214" BorderBrush="{StaticResource KlippBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                                                <Canvas x:Name="MotionEditorCanvas" Width="276" Height="155.25" Background="Transparent" HorizontalAlignment="Center"
                                                        PointerPressed="OnMotionEditorPointerPressed" PointerMoved="OnMotionEditorPointerMoved"
                                                        PointerReleased="OnMotionEditorPointerReleased" PointerCaptureLost="OnMotionEditorPointerCaptureLost"
                                                        AutomationProperties.Name="Source frame mask and tracking editor"
                                                        AutomationProperties.HelpText="Click to add polygon vertices. Drag vertices to refine. Select subject then drag to draw a tracking rectangle.">
                                                    <Image x:Name="MotionSourceFrameImage" Width="276" Height="155.25" Stretch="Fill" IsHitTestVisible="False" />
                                                </Canvas>
                                            </Border>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button x:Name="UndoPolygonPointButton" Content="Undo point" Height="32" HorizontalAlignment="Stretch" Click="OnUndoPolygonPointClicked" />
                                                <CheckBox x:Name="MotionMaskInvertCheckBox" Grid.Column="1" Content="Invert mask" MinHeight="32" FontSize="12" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button x:Name="ApplyPolygonMaskButton" Content="Apply mask" Height="32" HorizontalAlignment="Stretch" Click="OnApplyPolygonMaskClicked" />
                                                <Button x:Name="RemovePolygonMaskButton" Grid.Column="1" Content="Remove mask" Height="32" HorizontalAlignment="Stretch" Click="OnRemovePolygonMaskClicked" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Tracking zoom (%)" Style="{StaticResource KlippBodyTextSecondary}" FontSize="11" />
                                                    <NumberBox x:Name="MotionTrackingZoomBox" Minimum="110" Maximum="400" Value="150" SmallChange="10" SpinButtonPlacementMode="Compact" Height="32" AutomationProperties.Name="Tracking zoom percent" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="Range (seconds)" Style="{StaticResource KlippBodyTextSecondary}" FontSize="11" />
                                                    <NumberBox x:Name="MotionTrackingDurationBox" Minimum="0.5" Maximum="120" Value="15" SmallChange="5" SpinButtonPlacementMode="Compact" Height="32" AutomationProperties.Name="Tracking duration in timeline seconds" />
                                                </StackPanel>
                                            </Grid>
                                            <Button x:Name="StartMotionTrackingButton" Content="Keep subject in place" Height="32" HorizontalAlignment="Stretch" Click="OnStartMotionTrackingClicked"
                                                    ToolTipService.ToolTip="Track forward from the loaded source frame and create motion keyframes. Keys outside the tracked range are kept." />
                                        </StackPanel>
                                        <ProgressBar x:Name="MotionTrackingProgress" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Subject tracking progress" />
                                        <Button x:Name="CancelMotionTrackingButton" Content="Cancel tracking" Height="32" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnCancelMotionTrackingClicked" />
                                        <TextBlock x:Name="MotionToolsStatusText" Text="Select a video clip to draw a mask or track a subject."
                                                   Style="{StaticResource KlippBodyTextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Adjustment layer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Place and trim a separate look across the timeline." Style="{StaticResource KlippBodyTextSecondary}" />
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button x:Name="FilterNoneButton"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Click="OnFilterNoneClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="None"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterBoostButton"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Click="OnFilterBoostClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Boost"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterWarmButton"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Click="OnFilterWarmClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Warm"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterCoolButton"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Click="OnFilterCoolClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Cool"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterMonoButton"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Click="OnFilterMonoClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Mono"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterCinematicButton"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Click="OnFilterCinematicClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Cinematic"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterSharpenButton"
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Click="OnFilterSharpenClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Sharpen"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterBlurButton"
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Click="OnFilterBlurClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Soft blur"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterVintageButton"
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Click="OnFilterVintageClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Vintage"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterVibrantButton"
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Click="OnFilterVibrantClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Vibrant"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterNoirButton"
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Click="OnFilterNoirClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Noir"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterDreamButton"
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Click="OnFilterDreamClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Dream"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterGlitchButton"
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Click="OnFilterGlitchClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Glitch"  HorizontalAlignment="Stretch" />
                                    <Button x:Name="FilterVignetteButton"
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            Click="OnFilterVignetteClicked"
                                            HorizontalContentAlignment="Stretch" Height="32" Padding="10,0" Content="Vignette"  HorizontalAlignment="Stretch" />
                                </Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <StackPanel x:Name="ElementsPanel"
                                        Visibility="Collapsed"
                                        Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Images &amp; graphics"
                                               Style="{StaticResource KlippHeadingMedium}" />
                                    <TextBlock Text="Place images above the video, then move or trim them in the timeline."
                                               Style="{StaticResource KlippBodyTextSecondary}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                 <Button Click="OnImportGraphicLayerClicked"
                                         HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        ToolTipService.ToolTip="Import PNG, JPG, WebP or BMP">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="&#xE710;"
                                                   FontFamily="Segoe MDL2 Assets" />
                                        <TextBlock Text="Import image" />
                                     </StackPanel>
                                 </Button>
                                <Border Background="{StaticResource KlippSurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource KlippBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10">
                                    <StackPanel Spacing="9">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Brand assets" FontWeight="SemiBold" />
                                                <TextBlock x:Name="BrandLogoKitNameText"
                                                           Text="Select a brand kit"
                                                           FontSize="11"
                                                           Foreground="{StaticResource KlippTextMutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="36"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="OnImportBrandLogoClicked"
                                                    AutomationProperties.Name="Import logo into selected brand kit"
                                                    ToolTipService.ToolTip="Import reusable logo">
                                                <FontIcon Glyph="&#xE710;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="13" />
                                            </Button>
                                        </Grid>
                                        <ListView x:Name="BrandLogoList"
                                                  ItemsSource="{x:Bind BrandLogos}"
                                                  SelectionMode="None"
                                                  MaxHeight="220">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:EditorBrandLogoItem">
                                                    <Grid MinHeight="52" Padding="3" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="54" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="54" Height="44"
                                                                Background="#111116"
                                                                BorderBrush="{StaticResource KlippBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                Padding="3">
                                                            <Image Source="{x:Bind Preview}"
                                                                   Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="1">
                                                            <TextBlock Text="{x:Bind Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="Reusable logo"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource KlippTextMutedBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                Tag="{x:Bind Id}"
                                                                Click="OnAddBrandLogoToProjectClicked"
                                                                Height="32"
                                                                Padding="10,0"
                                                                Content="Add"
                                                                ToolTipService.ToolTip="Add logo at playhead"  HorizontalAlignment="Stretch" />
                                                        <Button Grid.Column="3"
                                                                Tag="{x:Bind Id}"
                                                                Click="OnRemoveBrandLogoClicked"
                                                                Width="32"
                                                                Height="32"
                                                                Padding="0"
                                                                AutomationProperties.Name="Remove logo from brand kit"
                                                                ToolTipService.ToolTip="Remove from brand kit">
                                                            <FontIcon Glyph="&#xE74D;"
                                                                      FontFamily="Segoe MDL2 Assets"
                                                                      FontSize="12" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel x:Name="BrandLogoEmptyState"
                                                    MinHeight="42"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Spacing="7"
                                                    IsHitTestVisible="False">
                                            <FontIcon Glyph="&#xEB9F;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      Foreground="{StaticResource KlippTextMutedBrush}" />
                                            <TextBlock Text="No reusable logos"
                                                       FontSize="11"
                                                       Foreground="{StaticResource KlippTextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="BrandLogoStatusText"
                                                   Text="Logos stay available across projects."
                                                   FontSize="11"
                                                   Foreground="{StaticResource KlippTextMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                 <Border Background="{StaticResource KlippSurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource KlippBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Graphic layers"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="GraphicLayerCountText"
                                                       Grid.Column="1"
                                                       Text="0"
                                                       FontFamily="{StaticResource KlippFontFamilyMono}"
                                                       Foreground="{StaticResource KlippAccentBrush}" />
                                        </Grid>
                                        <ListView x:Name="GraphicLayerList"
                                                  ItemsSource="{x:Bind GraphicLayers}"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="OnGraphicLayerItemClick"
                                                  MaxHeight="190">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="4" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="28" Height="28"
                                                                Background="#111116"
                                                                CornerRadius="4">
                                                            <TextBlock Text="&#xEB9F;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding RangeLabel}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource KlippTextSecondaryBrush}" />
                                                        </StackPanel>
