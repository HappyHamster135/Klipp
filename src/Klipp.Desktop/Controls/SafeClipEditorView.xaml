                                                        Spacing="8">
                                                <TextBlock Text="&#xE720;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13" />
                                                <TextBlock Text="Transcribe selected clip" />
                                            </StackPanel>
                                        </Button>
                                        <Grid x:Name="TranscriptionProgressHost"
                                              Visibility="Collapsed"
                                              ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar x:Name="TranscriptionProgressBar"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         VerticalAlignment="Center" />
                                            <Button x:Name="CancelTranscriptionButton"
                                                    Grid.Column="1"
                                                    Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="OnCancelTranscriptionClicked"
                                                    ToolTipService.ToolTip="Cancel transcription">
                                                <TextBlock Text="&#xE711;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" />
                                            </Button>
                                        </Grid>
                                        <TextBlock x:Name="TranscriptionStatusText"
                                                   Text="Select one timeline clip"
                                                   Foreground="{StaticResource KlippTextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBox x:Name="SubtitleTextBox"
                                         PlaceholderText="Enter subtitle text..."
                                         TextChanged="OnSubtitleTextChanged"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="110" />

                                <Border Background="{StaticResource KlippSurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource KlippBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Subtitle blocks"
                                                           Foreground="{StaticResource KlippTextPrimaryBrush}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Each block keeps its own time and style."
                                                           Foreground="{StaticResource KlippTextMutedBrush}"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <TextBlock x:Name="SubtitleLayerCountText"
                                                       Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource KlippFontFamilyMono}"
                                                       Foreground="{StaticResource KlippAccentBrush}"
                                                       Text="0" />
                                        </Grid>
                                        <Button x:Name="SaveSubtitleLayerButton"
                                                Click="OnAddSubtitleLayerClicked"
                                                HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="8">
                                                <TextBlock Text="&#xE710;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13" />
                                                <TextBlock x:Name="SaveSubtitleLayerButtonText"
                                                           Text="Add subtitle block" />
                                            </StackPanel>
                                        </Button>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Click="OnImportSubtitleSrtClicked"
                                                    ToolTipService.ToolTip="Import timed subtitles from SRT" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            Spacing="6">
                                                    <TextBlock Text="&#xE8B5;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12" />
                                                    <TextBlock Text="Import SRT" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Click="OnExportSubtitleSrtClicked"
                                                    ToolTipService.ToolTip="Export subtitle blocks as SRT" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            Spacing="6">
                                                    <TextBlock Text="&#xE898;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12" />
                                                    <TextBlock Text="Export SRT" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <ListView Height="132"
                                                  ItemsSource="{x:Bind SubtitleLayers}"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="OnSubtitleLayerItemClick"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:EditorProjectTextLayer">
                                                    <Grid Height="42" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{x:Bind Text}"
                                                                       Foreground="{StaticResource KlippTextPrimaryBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind RangeLabel}"
                                                                       Foreground="{StaticResource KlippTextMutedBrush}"
                                                                       FontSize="10" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Tag="{x:Bind Id}"
                                                                Click="OnRemoveSubtitleLayerClicked"
                                                                Width="32"
                                                                Height="32"
                                                                Padding="0"
                                                                ToolTipService.ToolTip="Remove subtitle block">
                                                            <TextBlock Text="&#xE74D;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="13" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="10">
                                    <TextBlock Text="Style"
                                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button x:Name="SubtitlePlainButton"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Click="OnSubtitlePlainClicked"
                                                Content="Plain"  HorizontalAlignment="Stretch" />
                                        <Button x:Name="SubtitleBoldButton"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Click="OnSubtitleBoldClicked"
                                                Content="Bold"  HorizontalAlignment="Stretch" />
                                        <Button x:Name="SubtitleHighlightButton"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Click="OnSubtitleHighlightClicked"
                                                Content="Highlight"  HorizontalAlignment="Stretch" />
                                        <Button x:Name="SubtitlePixelButton"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Click="OnSubtitlePixelClicked"
                                                Content="Pixel"  HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>

                                <Border Background="{StaticResource KlippSurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource KlippBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Typography"
                                                   Foreground="{StaticResource KlippTextPrimaryBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="SubtitleFontComboBox"
                                                  Header="Font"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnSubtitleFontChanged"
                                                  Loaded="OnTypographyFontPickerLoaded">
                                            <ComboBoxItem Content="Style default" Tag="auto" />
                                            <ComboBoxItem Content="Segoe UI" Tag="segoeui" />
                                            <ComboBoxItem Content="Arial" Tag="arial" />
                                            <ComboBoxItem Content="Georgia" Tag="georgia" />
                                            <ComboBoxItem Content="Times New Roman" Tag="times" />
                                            <ComboBoxItem Content="Consolas" Tag="consolas" />
                                            <ComboBoxItem Content="Impact" Tag="impact" />
                                            <ComboBoxItem Content="Trebuchet MS" Tag="trebuchet" />
                                        </ComboBox>
                                        <Border x:Name="SubtitleTypographySample"
                                                Height="64"
                                                Padding="8"
                                                Background="#343F49"
                                                CornerRadius="6"
                                                IsHitTestVisible="False"
                                                AutomationProperties.Name="Current typography preview" />
                                        <TextBlock x:Name="SubtitleCustomFontStatusText"
                                                   Text="System font"
                                                   FontSize="11"
                                                   Foreground="{StaticResource KlippTextMutedBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Text color"
                                                   Foreground="{StaticResource KlippTextSecondaryBrush}"
                                                   FontSize="12" />
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Button Width="32" Height="32" Padding="0" Background="#FFFFFF" BorderBrush="#66FFFFFF" Tag="#FFFFFF" Click="OnSubtitleColorSwatchClicked" AutomationProperties.Name="White subtitle color" ToolTipService.ToolTip="White" />
                                            <Button Width="32" Height="32" Padding="0" Background="#09090B" BorderBrush="#66FFFFFF" Tag="#000000" Click="OnSubtitleColorSwatchClicked" AutomationProperties.Name="Black subtitle color" ToolTipService.ToolTip="Black" />
                                            <Button Width="32" Height="32" Padding="0" Background="#EEFF26" BorderBrush="#66FFFFFF" Tag="#EEFF26" Click="OnSubtitleColorSwatchClicked" AutomationProperties.Name="Yellow subtitle color" ToolTipService.ToolTip="Highlight yellow" />
                                            <Button Width="32" Height="32" Padding="0" Background="#B0FF50" BorderBrush="#66FFFFFF" Tag="#B0FF50" Click="OnSubtitleColorSwatchClicked" AutomationProperties.Name="Lime subtitle color" ToolTipService.ToolTip="Lime" />
                                            <Button Width="32" Height="32" Padding="0" Background="#4CEBFF" BorderBrush="#66FFFFFF" Tag="#4CEBFF" Click="OnSubtitleColorSwatchClicked" AutomationProperties.Name="Cyan subtitle color" ToolTipService.ToolTip="Cyan" />
                                            <Button Width="32" Height="32" Padding="0" Background="#A970FF" BorderBrush="#66FFFFFF" Tag="#A970FF" Click="OnSubtitleColorSwatchClicked" AutomationProperties.Name="Purple subtitle color" ToolTipService.ToolTip="Purple" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="SubtitleColorPreview"
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="6"
                                                    BorderBrush="{StaticResource KlippBorderBrush}"
                                                    BorderThickness="1" />
                                            <TextBox x:Name="SubtitleColorHexBox"
                                                     Grid.Column="1"
                                                     Height="32"
                                                     PlaceholderText="#FFFFFF"
                                                     MaxLength="7"
                                                     LostFocus="OnSubtitleColorHexLostFocus"
                                                     KeyDown="OnSubtitleColorHexKeyDown" />
                                            <Button Grid.Column="2"
                                                    Width="40"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="OnResetSubtitleColorClicked"
                                                    ToolTipService.ToolTip="Use style color">
                                                <FontIcon Glyph="&#xE777;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Size"
                                                   Foreground="{StaticResource KlippTextPrimaryBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="SubtitleSizeValueText"
                                                   Grid.Column="1"
                                                   Text="42 px"
                                                   FontFamily="{StaticResource KlippFontFamilyMono}"
                                                   Foreground="{StaticResource KlippAccentBrush}" />
                                    </Grid>
                                    <Slider x:Name="SubtitleSizeSlider"
                                            ValueChanged="OnSubtitleSizeChanged" />
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <TextBlock Text="Position"
                                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SubtitlePositionTopButton"
                                                Grid.Column="0"
                                                Click="OnSubtitlePositionTopClicked"
                                                Content="Top"  HorizontalAlignment="Stretch" />
                                        <Button x:Name="SubtitlePositionCenterButton"
                                                Grid.Column="1"
                                                Click="OnSubtitlePositionCenterClicked"
                                                Content="Center"  HorizontalAlignment="Stretch" />
                                        <Button x:Name="SubtitlePositionBottomButton"
                                                Grid.Column="2"
                                                Click="OnSubtitlePositionBottomClicked"
                                                Content="Bottom"  HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="TimelinePanel" Grid.Row="2"
                Background="{StaticResource KlippSurfaceBrush}"
                BorderBrush="{StaticResource KlippBorderSubtleBrush}"
                BorderThickness="1,1,0,0"
                Padding="16,8">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Button Click="OnPreviousFrameClicked"
                            Width="32" Height="32" Padding="0" Background="Transparent"
                            BorderBrush="{StaticResource KlippBorderBrush}" CornerRadius="6"
                            AutomationProperties.Name="Previous frame"
                            ToolTipService.ToolTip="Previous frame (Left)">
                        <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="TimelinePlayButton"
                            Click="OnPlayPauseClicked"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="{StaticResource KlippAccentBrush}"
                            BorderThickness="0"
                            CornerRadius="4"
                            Foreground="White"
                            AutomationProperties.Name="Play or pause timeline"
                            ToolTipService.ToolTip="Play or pause timeline">
                        <TextBlock x:Name="TimelinePlayIcon"
                                   Text="&#xE768;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18" />
                    </Button>
                    <Button Click="OnNextFrameClicked"
                            Width="32" Height="32" Padding="0" Background="Transparent"
                            BorderBrush="{StaticResource KlippBorderBrush}" CornerRadius="6"
                            AutomationProperties.Name="Next frame"
                            ToolTipService.ToolTip="Next frame (Right)">
                        <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="LoopPreviewButton" Click="OnLoopPreviewClicked"
                            Width="32" Height="32" Padding="0" Background="Transparent"
                            BorderBrush="{StaticResource KlippBorderBrush}" CornerRadius="6"
                            AutomationProperties.Name="Loop playback off"
                            ToolTipService.ToolTip="Loop the selected playback range">
                        <TextBlock Text="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <Button x:Name="UndoTimelineButton"
                                Click="OnTimelineUndoClicked"
                                AutomationProperties.Name="Undo editor change"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="{StaticResource KlippBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ToolTipService.ToolTip="Undo timeline change">
                            <TextBlock Text="&#xE7A7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                        <Button x:Name="RedoTimelineButton"
                                Click="OnTimelineRedoClicked"
                                AutomationProperties.Name="Redo editor change"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="{StaticResource KlippBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ToolTipService.ToolTip="Redo timeline change">
                            <TextBlock Text="&#xE7A6;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                        <Button x:Name="SplitClipButton"
                                Click="OnSplitClipClicked"
                                AutomationProperties.Name="Split selected video and audio clips at playhead"
                                MinWidth="68"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="{StaticResource KlippBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ToolTipService.ToolTip="Split at playhead (S). Double-click a clip to split where you click.">
                            <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE8C6;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        <TextBlock Text="Split" FontSize="12" /></StackPanel></Button>
<Button x:Name="DetachAudioButton" Click="OnDetachAudioClicked" Height="32" Padding="9,0" CornerRadius="4" Content="Select audio" AutomationProperties.Name="Select source audio clip" ToolTipService.ToolTip="Choose this video's Game audio or Microphone clip to adjust, move, trim or split it independently." />

                        <Button x:Name="DuplicateClipButton"
                                Click="OnDuplicateTimelineClipClicked"
                                AutomationProperties.Name="Duplicate selected clips"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="{StaticResource KlippBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ToolTipService.ToolTip="Duplicate selected clips (Ctrl+D)">
                            <TextBlock Text="&#xE8C8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                        <Button x:Name="DeleteClipButton"
                                Click="OnDeleteTimelineClipClicked"
                                AutomationProperties.Name="Delete selected timeline items"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="{StaticResource KlippBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ToolTipService.ToolTip="Delete selected clips (Delete)">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                        <Button x:Name="TimecodeJumpButton" Click="OnGoToTimecodeClicked" Padding="4,0" MinHeight="24" Height="24"
                                Background="Transparent" BorderThickness="0" HorizontalAlignment="Center"
                                AutomationProperties.Name="Go to exact timeline timecode" ToolTipService.ToolTip="Go to timecode (Ctrl+G)">
                        <TextBlock x:Name="PositionText"

                               Text="0:00 / 0:00"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="8,0"
                               FontSize="12"
                               FontFamily="{StaticResource KlippFontFamilyMono}"
                               Foreground="{StaticResource KlippTextSecondaryBrush}" />
                        </Button>
                        <TextBlock x:Name="TimelineStatusText"

                               Margin="8,0"
                               MaxWidth="200"
                               TextTrimming="CharacterEllipsis"
                               Text="Timeline • 1s grid"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource KlippTextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                        <Button x:Name="TimelineSnapButton" Click="OnToggleTimelineSnappingClicked" Content="Snap" Height="32" Width="54" Padding="8,4"
                                AutomationProperties.Name="Toggle timeline snapping" ToolTipService.ToolTip="Snap clips, trims and cuts to nearby edits and the playhead" />
                        <Button Click="OnFitTimelineClicked" Content="Fit" Height="32" Width="44" Padding="8,4"
                                AutomationProperties.Name="Fit all timeline content" ToolTipService.ToolTip="Fit the whole project in the timeline" />
                        <Button Click="OnTimelineZoomOutClicked"
                                AutomationProperties.Name="Zoom out timeline"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="{StaticResource KlippBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ToolTipService.ToolTip="Zoom out timeline">
                            <TextBlock Text="&#xE71F;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                        <Button Click="OnTimelineZoomResetClicked"
                                AutomationProperties.Name="Reset timeline zoom"
                                Width="54"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="{StaticResource KlippBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ToolTipService.ToolTip="Reset timeline zoom">
                            <TextBlock x:Name="TimelineZoomText"
                                       Text="1x"
                                       FontFamily="{StaticResource KlippFontFamilyMono}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Button>
                        <Button Click="OnTimelineZoomInClicked"
                                AutomationProperties.Name="Zoom in timeline"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="{StaticResource KlippBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ToolTipService.ToolTip="Zoom in timeline">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>

                    </StackPanel>

                    <Button Grid.Column="4"
                            Click="OnResetTrimClicked"
                            Content="Reset range"
                            Background="Transparent"
                            Foreground="{StaticResource KlippTextSecondaryBrush}"
                            BorderBrush="{StaticResource KlippBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"  HorizontalAlignment="Stretch" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add track" Height="32" Padding="10,0" CornerRadius="4" AutomationProperties.Name="Add a timeline track">
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Video track" Click="OnAddVideoTrackClicked" />
                            <MenuFlyoutItem Text="Audio track" Click="OnAddAudioTrackClicked" />
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <ComboBox x:Name="TimelineEditToolComboBox" Width="134" Height="32" SelectedIndex="0"
                              SelectionChanged="OnTimelineEditToolChanged" AutomationProperties.Name="Timeline editing tool">
                        <ComboBoxItem Content="Select" Tag="Selection" />
                        <ComboBoxItem Content="Ripple trim" Tag="RippleTrim" />
                        <ComboBoxItem Content="Rolling trim" Tag="RollingTrim" />
                        <ComboBoxItem Content="Slip" Tag="Slip" />
                    </ComboBox>
                    <ToggleButton x:Name="LinkedSelectionToggle" Content="Select A/V" Height="32" Padding="10,0" CornerRadius="4"
                                  Checked="OnLinkedSelectionToggled" Unchecked="OnLinkedSelectionToggled"
                                  AutomationProperties.Name="Select related video and audio together"
                                  ToolTipService.ToolTip="Optionally select source video and audio together. They remain independently editable." />
                    <Button Content="Edit" Height="32" Padding="10,0" CornerRadius="4" AutomationProperties.Name="Timeline editing commands"
                            ToolTipService.ToolTip="Copy, paste, group and trim clips by frame">
                        <Button.Flyout><MenuFlyout Opening="OnTimelineEditMenuOpening">
                            <MenuFlyoutItem x:Name="CutTimelineMenuItem" Text="Cut clips" Click="OnCutTimelineSelectionClicked" />
                            <MenuFlyoutItem x:Name="CopyTimelineMenuItem" Text="Copy clips" Click="OnCopyTimelineSelectionClicked" />
                            <MenuFlyoutItem x:Name="PasteTimelineMenuItem" Text="Paste clips at playhead" Click="OnPasteTimelineSelectionClicked" />
                            <MenuFlyoutSubItem x:Name="PrecisionTimelineMenuItem" Text="Move and trim by frame">
                                <MenuFlyoutItem Text="Move one frame earlier" Click="OnLayerMoveBackClicked" />
                                <MenuFlyoutItem Text="Move one frame later" Click="OnLayerMoveForwardClicked" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Trim start one frame earlier" Click="OnLayerStartBackClicked" />
                                <MenuFlyoutItem Text="Trim start one frame later" Click="OnLayerStartForwardClicked" />
                                <MenuFlyoutItem Text="Trim end one frame earlier" Click="OnLayerEndBackClicked" />
                                <MenuFlyoutItem Text="Trim end one frame later" Click="OnLayerEndForwardClicked" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="RippleDeleteTimelineMenuItem" Text="Ripple delete selection" Click="OnRippleDeleteClicked" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Group selection" Click="OnGroupTimelineSelectionClicked" />
                            <MenuFlyoutItem Text="Ungroup selection" Click="OnUngroupTimelineSelectionClicked" />
                            <MenuFlyoutItem Text="Select all clips" Click="OnSelectAllTimelineClipsClicked" KeyboardAcceleratorTextOverride="Ctrl + A" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="GoToTimecodeMenuItem" Text="Go to timecode…" Click="OnGoToTimecodeClicked" />
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <Button Content="Attributes" Height="32" Padding="10,0" CornerRadius="4" AutomationProperties.Name="Copy and paste clip attributes">
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Copy transform and motion" Click="OnCopyTransformClicked" />
                            <MenuFlyoutItem Text="Paste transform and motion" Click="OnPasteTransformClicked" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Copy audio settings" Click="OnCopyAudioAttributesClicked" />
                            <MenuFlyoutItem Text="Paste audio settings" Click="OnPasteAudioAttributesClicked" />
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <Button Content="Ripple delete" Height="32" Padding="10,0" CornerRadius="4" Click="OnRippleDeleteClicked"
                            AutomationProperties.Name="Ripple delete selection" ToolTipService.ToolTip="Delete the selection and close its time on affected unlocked tracks (Shift+Delete)" />
                    <Button Content="Close gap" Height="32" Padding="10,0" CornerRadius="4" Click="OnCloseTimelineGapClicked"
                            AutomationProperties.Name="Close timeline gap at playhead" />
                    <Button Content="Audio crossfade" Height="32" Padding="10,0" CornerRadius="4" Click="OnAudioCrossfadeClicked"
                            AutomationProperties.Name="Crossfade adjacent audio clips" ToolTipService.ToolTip="Create an audio crossfade at the playhead or selected audio join" />
                </StackPanel>
                    <Button x:Name="EditorShortcutsButton" Grid.Column="1" Content="Shortcuts" Height="32" Padding="10,0" CornerRadius="4"
                            Click="OnEditorShortcutsClicked" AutomationProperties.Name="Editor keyboard shortcuts and gestures"
                            ToolTipService.ToolTip="Editor shortcuts (F1)" />
                </Grid>
                <ScrollViewer x:Name="TimelineScrollViewer" Grid.Row="2" Height="220" MinHeight="96"
                              Loaded="OnTimelineViewportLoaded" Unloaded="OnTimelineViewportUnloaded"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <controls:LayerTimelineEditor x:Name="LayerTimeline"
                                                  TimelineChanged="OnLayerTimelineChanged" />
                </ScrollViewer>
                <Border x:Name="TimelineHeightGrip" Grid.Row="0" Height="10" Margin="0,-10,0,0"
                        VerticalAlignment="Top" Background="Transparent"
                        ToolTipService.ToolTip="Drag up or down to resize the timeline"
                        AutomationProperties.Name="Resize timeline"
                        PointerPressed="OnTimelineHeightGripPressed" PointerMoved="OnTimelineHeightGripMoved"
                        PointerReleased="OnTimelineHeightGripReleased" PointerCanceled="OnTimelineHeightGripCanceled"
                        PointerCaptureLost="OnTimelineHeightGripCaptureLost"
                        PointerEntered="OnTimelineHeightGripEntered" PointerExited="OnTimelineHeightGripExited">
                    <Border Width="48" Height="3" CornerRadius="2" VerticalAlignment="Center"
                            Background="{StaticResource KlippTextMutedBrush}" Opacity="0.65" IsHitTestVisible="False" />
                </Border>
            </Grid>
        </Border>
        <Popup x:Name="TransitionAuditionPopup" IsLightDismissEnabled="False" Closed="OnTransitionAuditionPopupClosed">
            <Border x:Name="TransitionAuditionCard" Width="280" KeyDown="OnTransitionAuditionKeyDown" Background="{StaticResource KlippSurfaceElevatedBrush}"
                    BorderBrush="{StaticResource KlippBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TransitionAuditionNameText" Text="Cross dissolve" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource KlippTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="A → B" FontSize="11"
                                   Foreground="{StaticResource KlippTextMutedBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0"
                                Click="OnCloseTransitionAuditionClicked" AutomationProperties.Name="Close transition sample"
                                ToolTipService.ToolTip="Close preview (Esc)">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </Grid>
                    <Viewbox Height="126" Stretch="Uniform" HorizontalAlignment="Stretch" IsHitTestVisible="False"
                             AutomationProperties.AccessibilityView="Raw">
                        <Grid Width="256" Height="144" Background="Black">
                            <Grid.Clip><RectangleGeometry Rect="0,0,256,144" /></Grid.Clip>
                            <Grid x:Name="TransitionAuditionOutgoing" Background="#19313C">
                                <Grid.RenderTransform><TranslateTransform x:Name="TransitionAuditionOutgoingTransform" /></Grid.RenderTransform>
                                <Canvas>
                                    <Ellipse Width="29" Height="29" Fill="#D9BC86" Canvas.Left="176" Canvas.Top="25" />
                                    <Polygon Points="0,115 65,51 149,144 0,144" Fill="#3D6570" />
                                    <Polygon Points="70,144 164,68 256,131 256,144" Fill="#294D58" />
                                    <Rectangle Width="256" Height="19" Canvas.Top="125" Fill="#142731" />
                                </Canvas>
                                <Border Background="#B3142731" Padding="7,2" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="2">
                                    <TextBlock Text="A" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                                </Border>
                            </Grid>
                            <Grid x:Name="TransitionAuditionIncomingReveal">
                                <Grid.Clip><RectangleGeometry x:Name="TransitionAuditionRevealGeometry" Rect="0,0,256,144" /></Grid.Clip>
                                <Grid x:Name="TransitionAuditionShapeHost" IsHitTestVisible="False">
                                <Grid x:Name="TransitionAuditionIncoming" Background="#4A3B33">
                                    <Grid.RenderTransform><TranslateTransform x:Name="TransitionAuditionIncomingTransform" /></Grid.RenderTransform>
                                    <Canvas>
                                        <Ellipse Width="36" Height="36" Fill="#E0C39B" Canvas.Left="49" Canvas.Top="32" />
                                        <Polygon Points="0,119 84,79 169,144 0,144" Fill="#8E7560" />
                                        <Polygon Points="94,144 188,62 256,113 256,144" Fill="#6B5547" />
                                        <Rectangle Width="256" Height="19" Canvas.Top="125" Fill="#352C28" />
                                    </Canvas>
                                    <Border Background="#B3352C28" Padding="7,2" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="2">
                                        <TextBlock Text="B" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                                    </Border>
                                </Grid>
                                </Grid>
                            </Grid>
                            <Rectangle x:Name="TransitionAuditionWhiteOverlay" Fill="White" Opacity="0" />
                        </Grid>
                    </Viewbox>
                    <ComboBox x:Name="TransitionAuditionDirectionComboBox" HorizontalAlignment="Stretch" Visibility="Collapsed"
                              SelectionChanged="OnTransitionAuditionDirectionChanged" AutomationProperties.Name="Sample transition direction" />
                    <Slider x:Name="TransitionAuditionProgressSlider" Minimum="0" Maximum="100" Value="0" StepFrequency="1"
                            IsThumbToolTipEnabled="False" ValueChanged="OnTransitionAuditionProgressChanged"
                            AutomationProperties.Name="Transition sample progress"
                            AutomationProperties.HelpText="Scrub the sample from A to B without moving the project playhead" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="TransitionAuditionPlayButton" Click="OnTransitionAuditionPlayClicked" Height="32"
                                HorizontalAlignment="Stretch" AutomationProperties.Name="Play transition sample">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="TransitionAuditionPlayIcon" Glyph="&#xE768;" FontSize="12" />
                                <TextBlock x:Name="TransitionAuditionPlayText" Text="Play" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="TransitionAuditionLoopButton" Grid.Column="1" Content="Loop" Height="32" IsChecked="True"
                                      AutomationProperties.Name="Loop transition sample" ToolTipService.ToolTip="Repeat this sample while it is playing" />
                        <ComboBox x:Name="TransitionAuditionDurationComboBox" Grid.Column="2" Width="92" MinWidth="0" Height="32" FontSize="12" Padding="8,4"
                                  SelectionChanged="OnTransitionAuditionDurationChanged" AutomationProperties.Name="Transition sample duration"
                                  ToolTipService.ToolTip="Duration for the sample and the next applied transition">
                            <ComboBoxItem Tag="0.25" Content="0.25 s" />
                            <ComboBoxItem Tag="0.5" Content="0.5 s" IsSelected="True" />
                            <ComboBoxItem Tag="1" Content="1 s" />
                        </ComboBox>
                    </Grid>
                    <Button x:Name="ApplyTransitionAuditionButton" Content="Apply to selected join" Click="OnApplyTransitionAuditionClicked"
                            Height="32" HorizontalAlignment="Stretch" IsEnabled="False"
                            AutomationProperties.HelpText="Apply this transition and sample duration to the join before the selected video clip" />
                    <TextBlock x:Name="TransitionAuditionApplyHintText" Text="Select a video clip after a join to apply."
                               Style="{StaticResource KlippBodyTextSecondary}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
