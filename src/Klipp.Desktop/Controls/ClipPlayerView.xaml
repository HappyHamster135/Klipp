<UserControl
    x:Class="Klipp.Desktop.Controls.ClipPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Klipp.Desktop.Controls">

    <controls:PlaybackCursorGrid x:Name="PlayerRoot"
          Background="Black"
          PointerMoved="OnPlayerPointerMoved"
          PointerEntered="OnPlayerPointerMoved">
        <Border Background="Black">
            <MediaPlayerElement x:Name="NativePlayer"
                                AutoPlay="True"
                                AreTransportControlsEnabled="False"
                                Stretch="Uniform"
                                Tapped="OnPlayerTapped"
                                DoubleTapped="OnPlayerDoubleTapped" />
        </Border>

        <Button x:Name="CenterPlayButton"
                Click="OnPlayPauseClicked"
                AutomationProperties.Name="Play or pause clip"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="48"
                Height="48"
                Background="{StaticResource KlippAccentBrush}"
                BorderThickness="0"
                CornerRadius="4"
                Foreground="#101419"
                Padding="0"
                Opacity="0.96"
                RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <ScaleTransform x:Name="CenterPlayButtonTransform" ScaleX="1" ScaleY="1" />
            </Button.RenderTransform>
            <TextBlock x:Name="CenterPlayIcon"
                       Text="&#xE768;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       Margin="2,0,0,0" />
        </Button>

        <!-- Header-overlay -->
        <Grid x:Name="HeaderChrome"
              VerticalAlignment="Top"
              Padding="16,8">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HeaderChromeTransform" Y="0" />
            </Grid.RenderTransform>
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource KlippTitleBarColor}" />
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="OnBackClicked"
                    Background="Transparent"
                    BorderBrush="{StaticResource KlippBorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource KlippTextSecondaryBrush}"
                    Padding="10,4"
                    CornerRadius="4"
                    FontSize="13" Height="32">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    <TextBlock Text="Library" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       x:Name="TitleText"
                       Text="Clip"
                       Style="{StaticResource KlippHeadingMedium}"
                       Margin="16,0,16,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Click="OnTrimClicked" Height="32" Padding="10,4"
                        AutomationProperties.Name="Edit clip" ToolTipService.ToolTip="Edit clip">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" />
                        <TextBlock Text="Edit clip" />
                    </StackPanel>
                </Button>
                <Button Width="32" Height="32" Padding="0" AutomationProperties.Name="More clip actions">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Show in folder" Click="OnOpenFolderClicked" />
                            <MenuFlyoutItem Text="Rename" Click="OnRenameClicked" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Delete" Click="OnDeleteClicked" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="ControlsChrome"
              VerticalAlignment="Bottom"
              Padding="16,12">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ControlsChromeTransform" Y="0" />
            </Grid.RenderTransform>
            <Grid.Background>
                <SolidColorBrush Color="#EE1C1F23" />
            </Grid.Background>

            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CurrentTimeText"
                               Grid.Column="0"
                               Text="0:00"
                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               MinWidth="42" />

                    <Slider x:Name="ProgressSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            Foreground="{StaticResource KlippAccentBrush}"
                            Background="#55FFFFFF"
                            AutomationProperties.Name="Clip position"
                            VerticalAlignment="Center"
                            ValueChanged="OnProgressValueChanged" />

                    <TextBlock x:Name="TotalTimeText"
                               Grid.Column="2"
                               Text="0:00"
                               Foreground="{StaticResource KlippTextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               MinWidth="42" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PlayPauseButton"
                            Grid.Column="0"
                            Click="OnPlayPauseClicked"
                            AutomationProperties.Name="Play or pause clip"
                            Width="32"
                            Height="32"
                            Background="{StaticResource KlippAccentBrush}"
                            BorderThickness="0"
                            CornerRadius="4"
                            Foreground="#101419"
                            Padding="0">
                        <TextBlock x:Name="PlayPauseIcon"
                                   Text="&#xE769;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" />
                    </Button>

                    <Button Grid.Column="1"
                            Click="OnBack10Clicked"
                            AutomationProperties.Name="Back ten seconds"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource KlippTextPrimaryBrush}"
                            Padding="0"
                            VerticalAlignment="Center">
                        <TextBlock Text="−10"
                                   FontSize="12" />
                    </Button>

                    <Button Grid.Column="2"
                            Click="OnForward10Clicked"
                            AutomationProperties.Name="Forward ten seconds"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource KlippTextPrimaryBrush}"
                            Padding="0"
                            VerticalAlignment="Center">
                        <TextBlock Text="+10"
                                   FontSize="12" />
                    </Button>

                    <Button Grid.Column="3"
                            Click="OnMuteClicked"
                            AutomationProperties.Name="Mute or unmute clip"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource KlippTextPrimaryBrush}"
                            Padding="0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="MuteIcon"
                                   Text="&#xE995;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" />
                    </Button>

                    <Slider x:Name="VolumeSlider"
                            Grid.Column="4"
                            Minimum="0"
                            Maximum="100"
                            Value="80"
                            Foreground="{StaticResource KlippTextPrimaryBrush}"
                            Background="#4DFFFFFF"
                            AutomationProperties.Name="Clip volume"
                            VerticalAlignment="Center"
                            ValueChanged="OnVolumeValueChanged" />

                    <Button Grid.Column="6"
                            Click="OnFullscreenClicked"
                            AutomationProperties.Name="Toggle fullscreen"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource KlippTextPrimaryBrush}"
                            Padding="0"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE740;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" />
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Vänster pil -->
        <Button x:Name="PrevButton"
                Click="OnPrevClicked"
                AutomationProperties.Name="Previous clip"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="18,0,0,0"
                Width="32"
                Height="32"
                Background="#A6000000"
                BorderThickness="0"
                CornerRadius="4"
                Foreground="{StaticResource KlippTextPrimaryBrush}"
                FontSize="16"
                FontWeight="SemiBold"
                Padding="0">
            <Button.RenderTransform>
                <TranslateTransform x:Name="PrevButtonTransform" X="0" />
            </Button.RenderTransform>
            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
        </Button>

        <!-- Höger pil -->
        <Button x:Name="NextButton"
                Click="OnNextClicked"
                AutomationProperties.Name="Next clip"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,18,0"
                Width="32"
                Height="32"
                Background="#A6000000"
                BorderThickness="0"
                CornerRadius="4"
                Foreground="{StaticResource KlippTextPrimaryBrush}"
                FontSize="16"
                FontWeight="SemiBold"
                Padding="0">
            <Button.RenderTransform>
                <TranslateTransform x:Name="NextButtonTransform" X="0" />
            </Button.RenderTransform>
            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
        </Button>
    </controls:PlaybackCursorGrid>
</UserControl>
