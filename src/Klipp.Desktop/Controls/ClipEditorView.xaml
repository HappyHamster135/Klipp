<UserControl
    x:Class="Klipp.Desktop.Controls.ClipEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Klipp.Desktop.Controls">

    <Grid Background="{StaticResource KlippBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Padding="24,16"
              Background="{StaticResource KlippSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="OnBackClicked"
                    Background="Transparent"
                    BorderBrush="{StaticResource KlippBorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource KlippTextSecondaryBrush}"
                    Padding="12,7,14,7"
                    CornerRadius="8"
                    FontSize="13">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="&#x2190;" FontSize="14" />
                    <TextBlock Text="Library" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1"
                        Margin="18,0"
                        VerticalAlignment="Center"
                        Spacing="2">
                <TextBlock x:Name="EditorTitleText"
                           Text="Editor"
                           Style="{StaticResource KlippHeadingMedium}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Edit and export a new version"
                           Style="{StaticResource KlippBodyTextSecondary}"
                           FontSize="12" />
            </StackPanel>

            <Button Grid.Column="2"
                    Click="OnExportClicked"
                    Background="{StaticResource KlippAccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="18,8,18,8"
                    CornerRadius="8"
                    FontSize="13"
                    FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE74E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14" />
                    <TextBlock Text="Export" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              Padding="24"
              ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="456" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="Black"
                    BorderBrush="{StaticResource KlippBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource KlippRadiusMd}">
                <Grid>
                    <Grid x:Name="EditorPreviewSurface"
                          Background="Black"
                          Tapped="OnPreviewTapped">
                        <Image x:Name="EditorPreviewImage"
                               Stretch="Uniform"
                               Opacity="0" />
                    </Grid>

                    <Border x:Name="VfxTintOverlay"
                            Background="Transparent"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <Grid x:Name="ElementLetterboxOverlay"
                          Visibility="Collapsed"
                          IsHitTestVisible="False">
                        <Border Height="46"
                                VerticalAlignment="Top"
                                Background="Black" />
                        <Border Height="46"
                                VerticalAlignment="Bottom"
                                Background="Black" />
                    </Grid>

                    <Border x:Name="ElementFocusFrame"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Margin="70,54"
                            BorderBrush="White"
                            BorderThickness="3"
                            CornerRadius="10"
                            Opacity="0.82" />

                    <Grid x:Name="ElementCenterMarker"
                          Visibility="Collapsed"
                          IsHitTestVisible="False"
                          Width="72"
                          Height="72"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0.86">
                        <Border Width="56"
                                Height="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="2" />
                        <Border Width="4"
                                Height="56"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="2" />
                    </Grid>

                    <Border x:Name="TextOverlayBackground"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="26"
                            Padding="12,6"
                            CornerRadius="8"
                            Background="#00000000">
                        <TextBlock x:Name="TextOverlayPreview"
                                   Text=""
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                    </Border>

                    <Border x:Name="SubtitleOverlayBackground"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="28,28,28,74"
                            Padding="12,6"
                            CornerRadius="8"
                            Background="#A6000000">
                        <TextBlock x:Name="SubtitleOverlayPreview"
                                   Text=""
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                    </Border>

                    <Button x:Name="PreviewPlayButton"
                            Click="OnPlayPauseClicked"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="82"
                            Height="82"
                            Background="{StaticResource KlippAccentBrush}"
                            BorderThickness="0"
                            CornerRadius="41"
                            Foreground="White"
                            Padding="0">
                        <TextBlock x:Name="PreviewPlayIcon"
                                   Text="&#xE768;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="30"
                                   Margin="4,0,0,0" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource KlippSurfaceBrush}"
                        BorderBrush="{StaticResource KlippBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource KlippRadiusMd}"
                        Padding="8">
                    <StackPanel Spacing="8">
                        <Button x:Name="GeneralToolButton"
                                Click="OnGeneralToolClicked"
                                Padding="0"
                                Height="58"
                                CornerRadius="8">
                            <StackPanel Spacing="4"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Width="24"
                                           Height="24"
                                           FontSize="20"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="General"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TextToolButton"
                                Click="OnTextToolClicked"
                                Padding="0"
                                Height="58"
                                CornerRadius="8">
                            <StackPanel Spacing="4"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="A"
                                           FontFamily="Georgia"
                                           Width="24"
                                           Height="24"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Text"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ElementsToolButton"
                                Click="OnElementsToolClicked"
                                Padding="0"
                                Height="58"
                                CornerRadius="8">
                            <StackPanel Spacing="4"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7C3;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Width="24"
                                           Height="24"
                                           FontSize="20"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Elements"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="VfxToolButton"
                                Click="OnVfxToolClicked"
                                Padding="0"
                                Height="58"
                                CornerRadius="8">
                            <StackPanel Spacing="4"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE945;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Width="24"
                                           Height="24"
                                           FontSize="20"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="VFX"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TransitionsToolButton"
                                Click="OnTransitionsToolClicked"
                                Padding="0"
                                Height="58"
                                CornerRadius="8">
                            <StackPanel Spacing="4"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8AB;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Width="24"
                                           Height="24"
                                           FontSize="20"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Transitions"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="AudioToolButton"
                                Click="OnAudioToolClicked"
                                Padding="0"
                                Height="58"
                                CornerRadius="8">
                            <StackPanel Spacing="4"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE767;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Width="24"
                                           Height="24"
                                           FontSize="20"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Audio"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="SubtitlesToolButton"
                                Click="OnSubtitlesToolClicked"
                                Padding="0"
                                Height="58"
                                CornerRadius="8">
                            <StackPanel Spacing="4"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8FF;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Width="24"
                                           Height="24"
                                           FontSize="20"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Subtitles"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource KlippSurfaceBrush}"
                        BorderBrush="{StaticResource KlippBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource KlippRadiusMd}"
                        Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <StackPanel x:Name="GeneralPanel"
                                        Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="General"
                                               Style="{StaticResource KlippHeadingMedium}" />
                                    <TextBlock Text="Trim, playback speed and basic controls."
                                               Style="{StaticResource KlippBodyTextSecondary}"
                                               FontSize="12" />
                                </StackPanel>

                                <Border Background="{StaticResource KlippSurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource KlippBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Start"
                                                       Style="{StaticResource KlippBodyTextSecondary}" />
                                            <TextBlock x:Name="StartText"
                                                       Grid.Column="1"
                                                       Text="0:00"
                                                       FontFamily="{StaticResource KlippFontFamilyMono}"
                                                       Foreground="{StaticResource KlippTextPrimaryBrush}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="End"
                                                       Style="{StaticResource KlippBodyTextSecondary}" />
                                            <TextBlock x:Name="EndText"
                                                       Grid.Column="1"
                                                       Text="0:00"
                                                       FontFamily="{StaticResource KlippFontFamilyMono}"
                                                       Foreground="{StaticResource KlippTextPrimaryBrush}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Selection"
                                                       Style="{StaticResource KlippBodyTextSecondary}" />
                                            <TextBlock x:Name="SelectionText"
                                                       Grid.Column="1"
                                                       Text="0:00"
                                                       FontFamily="{StaticResource KlippFontFamilyMono}"
                                                       Foreground="{StaticResource KlippAccentBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="8">
                                    <Button Click="OnSeekStartClicked"
                                            Content="Go to start"
                                            HorizontalAlignment="Stretch"
                                            Background="Transparent"
                                            Foreground="{StaticResource KlippTextSecondaryBrush}"
                                            BorderBrush="{StaticResource KlippBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8" />
                                    <Button Click="OnSeekEndClicked"
                                            Content="Go to end"
                                            HorizontalAlignment="Stretch"
                                            Background="Transparent"
                                            Foreground="{StaticResource KlippTextSecondaryBrush}"
                                            BorderBrush="{StaticResource KlippBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8" />
                                    <Button Click="OnResetTrimClicked"
                                            Content="Reset trim"
                                            HorizontalAlignment="Stretch"
                                            Background="Transparent"
                                            Foreground="{StaticResource KlippTextSecondaryBrush}"
                                            BorderBrush="{StaticResource KlippBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8" />
                                </StackPanel>

                                <Border Height="1"
                                        Background="{StaticResource KlippBorderSubtleBrush}"
                                        Opacity="0.9" />

                                <StackPanel Spacing="10">
                                    <TextBlock Text="Speed"
                                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="Speed05Button"
                                                Grid.Column="0"
                                                Click="OnSpeed05Clicked"
                                                Content="0.5x"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="8" />
                                        <Button x:Name="Speed1Button"
                                                Grid.Column="1"
                                                Click="OnSpeed1Clicked"
                                                Content="1x"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="8" />
                                        <Button x:Name="Speed15Button"
                                                Grid.Column="2"
                                                Click="OnSpeed15Clicked"
                                                Content="1.5x"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="8" />
                                        <Button x:Name="Speed2Button"
                                                Grid.Column="3"
                                                Click="OnSpeed2Clicked"
                                                Content="2x"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="8" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="TextPanel"
                                        Visibility="Collapsed"
                                        Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Text"
                                               Style="{StaticResource KlippHeadingMedium}" />
                                    <TextBlock Text="Add a title or callout to the clip."
                                               Style="{StaticResource KlippBodyTextSecondary}"
                                               FontSize="12" />
                                </StackPanel>

                                <TextBox x:Name="TextOverlayBox"
                                         PlaceholderText="Enter text..."
                                         TextChanged="OnTextOverlayChanged"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="84" />

                                <StackPanel Spacing="10">
                                    <TextBlock Text="Style"
                                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8"
                                          RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button x:Name="TextPlainButton"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Click="OnTextPlainClicked"
                                                Content="Plain" />
                                        <Button x:Name="TextBoldButton"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Click="OnTextBoldClicked"
                                                Content="Bold" />
                                        <Button x:Name="TextMemeButton"
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Click="OnTextMemeClicked"
                                                Content="Meme" />
                                        <Button x:Name="TextHighlightButton"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Click="OnTextHighlightClicked"
                                                Content="Highlight" />
                                        <Button x:Name="TextPixelButton"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Click="OnTextPixelClicked"
                                                Content="Pixel" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <TextBlock Text="Position"
                                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="TextPositionTopButton"
                                                Grid.Column="0"
                                                Click="OnTextPositionTopClicked"
                                                Content="Top" />
                                        <Button x:Name="TextPositionCenterButton"
                                                Grid.Column="1"
                                                Click="OnTextPositionCenterClicked"
                                                Content="Center" />
                                        <Button x:Name="TextPositionBottomButton"
                                                Grid.Column="2"
                                                Click="OnTextPositionBottomClicked"
                                                Content="Bottom" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="ElementsPanel"
                                        Visibility="Collapsed"
                                        Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Elements"
                                               Style="{StaticResource KlippHeadingMedium}" />
                                    <TextBlock Text="Use overlays to highlight parts of the video."
                                               Style="{StaticResource KlippBodyTextSecondary}"
                                               FontSize="12" />
                                </StackPanel>

                                <Grid ColumnSpacing="8"
                                      RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button x:Name="ElementNoneButton"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Click="OnElementNoneClicked"
                                            Content="None" />
                                    <Button x:Name="ElementFocusButton"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Click="OnElementFocusClicked"
                                            Content="Focus frame" />
                                    <Button x:Name="ElementLetterboxButton"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Click="OnElementLetterboxClicked"
                                            Content="Cinematic bars" />
                                    <Button x:Name="ElementCenterButton"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Click="OnElementCenterClicked"
                                            Content="Center mark" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="VfxPanel"
                                        Visibility="Collapsed"
                                        Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="VFX"
                                               Style="{StaticResource KlippHeadingMedium}" />
                                    <TextBlock Text="Filters applied to the exported video."
                                               Style="{StaticResource KlippBodyTextSecondary}"
                                               FontSize="12" />
                                </StackPanel>

                                <Grid ColumnSpacing="8"
                                      RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button x:Name="FilterNoneButton"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Click="OnFilterNoneClicked"
                                            Content="None" />
                                    <Button x:Name="FilterBoostButton"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Click="OnFilterBoostClicked"
                                            Content="Boost" />
                                    <Button x:Name="FilterWarmButton"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Click="OnFilterWarmClicked"
                                            Content="Warm" />
                                    <Button x:Name="FilterCoolButton"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Click="OnFilterCoolClicked"
                                            Content="Cool" />
                                    <Button x:Name="FilterMonoButton"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Click="OnFilterMonoClicked"
                                            Content="Mono" />
                                    <Button x:Name="FilterCinematicButton"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Click="OnFilterCinematicClicked"
                                            Content="Cinematic" />
                                    <Button x:Name="FilterSharpenButton"
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Click="OnFilterSharpenClicked"
                                            Content="Sharpen" />
                                    <Button x:Name="FilterBlurButton"
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Click="OnFilterBlurClicked"
                                            Content="Soft blur" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="TransitionsPanel"
                                        Visibility="Collapsed"
                                        Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Transitions"
                                               Style="{StaticResource KlippHeadingMedium}" />
                                    <TextBlock Text="Add fades or freeze the last frame."
                                               Style="{StaticResource KlippBodyTextSecondary}"
                                               FontSize="12" />
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <TextBlock Text="Fade in"
                                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="FadeInNoneButton"
                                                Grid.Column="0"
                                                Click="OnFadeInNoneClicked"
                                                Content="Off" />
                                        <Button x:Name="FadeIn05Button"
                                                Grid.Column="1"
                                                Click="OnFadeIn05Clicked"
                                                Content="0.5s" />
                                        <Button x:Name="FadeIn1Button"
                                                Grid.Column="2"
                                                Click="OnFadeIn1Clicked"
                                                Content="1s" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <TextBlock Text="Fade out"
                                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="FadeOutNoneButton"
                                                Grid.Column="0"
                                                Click="OnFadeOutNoneClicked"
                                                Content="Off" />
                                        <Button x:Name="FadeOut05Button"
                                                Grid.Column="1"
                                                Click="OnFadeOut05Clicked"
                                                Content="0.5s" />
                                        <Button x:Name="FadeOut1Button"
                                                Grid.Column="2"
                                                Click="OnFadeOut1Clicked"
                                                Content="1s" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <TextBlock Text="Freeze last frame"
                                               Foreground="{StaticResource KlippTextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Freeze0Button"
                                                Grid.Column="0"
                                                Click="OnFreeze0Clicked"
                                                Content="Off" />
                                        <Button x:Name="Freeze1Button"
                                                Grid.Column="1"
                                                Click="OnFreeze1Clicked"
                                                Content="1s" />
                                        <Button x:Name="Freeze2Button"
                                                Grid.Column="2"
                                                Click="OnFreeze2Clicked"
                                                Content="2s" />
                                        <Button x:Name="Freeze3Button"
                                                Grid.Column="3"
                                                Click="OnFreeze3Clicked"
                                                Content="3s" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="AudioPanel"
                                        Visibility="Collapsed"
                                        Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Audio"
                                               Style="{StaticResource KlippHeadingMedium}" />
                                    <TextBlock Text="Set the volume for the exported video."
                                               Style="{StaticResource KlippBodyTextSecondary}"
                                               FontSize="12" />
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Volume"
                                                   Foreground="{StaticResource KlippTextPrimaryBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="VolumeValueText"
                                                   Grid.Column="1"
                                                   Text="100%"
                                                   FontFamily="{StaticResource KlippFontFamilyMono}"
                                                   Foreground="{StaticResource KlippAccentBrush}" />
                                    </Grid>

                                    <Slider x:Name="EditorVolumeSlider"
                                            Minimum="0"
                                            Maximum="200"
                                            Value="100"
                                            ValueChanged="OnEditorVolumeChanged" />

                                    <ToggleSwitch x:Name="MuteAudioToggle"
                                                  Header="Mute audio in export"
                                                  Toggled="OnMuteAudioToggled" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SubtitlesPanel"
                                        Visibility="Collapsed"
                                        Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Subtitles"
                                               Style="{StaticResource KlippHeadingMedium}" />
                                    <TextBlock Text="Add a subtitle to the video."
                                               Style="{StaticResource KlippBodyTextSecondary}"
                                               FontSize="12" />
                                </StackPanel>

                                <TextBox x:Name="SubtitleTextBox"
                                         PlaceholderText="Enter subtitle..."
                                         TextChanged="OnSubtitleTextChanged"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="110" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource KlippSurfaceBrush}"
                BorderBrush="{StaticResource KlippBorderSubtleBrush}"
                BorderThickness="1,1,0,0"
                Padding="24,16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Click="OnPlayPauseClicked"
                            Width="44"
                            Height="44"
                            Padding="0"
                            Background="{StaticResource KlippAccentBrush}"
                            BorderThickness="0"
                            CornerRadius="8"
                            Foreground="White">
                        <TextBlock x:Name="TimelinePlayIcon"
                                   Text="&#xE768;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18" />
                    </Button>

                    <TextBlock x:Name="PositionText"
                               Grid.Column="1"
                               Text="0:00 / 0:00"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource KlippFontFamilyMono}"
                               Foreground="{StaticResource KlippTextSecondaryBrush}" />

                    <Button Grid.Column="2"
                            Click="OnResetTrimClicked"
                            Content="Reset"
                            Background="Transparent"
                            Foreground="{StaticResource KlippTextSecondaryBrush}"
                            BorderBrush="{StaticResource KlippBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8" />
                </Grid>

                <controls:LayerTimelineEditor x:Name="LayerTimeline"
                                              Grid.Row="1"
                                              TimelineChanged="OnLayerTimelineChanged" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
