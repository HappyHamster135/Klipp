<UserControl
    x:Class="Klipp.Desktop.Controls.ColorCurveEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#09090D"
            BorderBrush="#3B3B48"
            BorderThickness="1"
            CornerRadius="6"
            MinHeight="180">
        <Grid x:Name="CurveSurface"
              Margin="10"
              MinHeight="158"
              SizeChanged="OnCurveSurfaceSizeChanged"
              PointerReleased="OnCurveSurfacePointerReleased"
              PointerCanceled="OnCurveSurfacePointerCanceled"
              PointerCaptureLost="OnCurveSurfacePointerCaptureLost">
            <Canvas x:Name="GridCanvas"
                    IsHitTestVisible="False" />
            <Polyline x:Name="CurveLine"
                      Stroke="#A970FF"
                      StrokeThickness="2.5"
                      StrokeLineJoin="Round"
                      IsHitTestVisible="False" />
            <Canvas x:Name="PointsCanvas" />
        </Grid>
    </Border>
</UserControl>
