<UserControl
    x:Class="Klipp.Desktop.Controls.CommunityFeedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Klipp.Desktop.Controls"
    KeyDown="OnFeedKeyDown">
    <StackPanel Spacing="14">
        <Grid x:Name="FeedToolbar" ColumnSpacing="12" SizeChanged="OnFeedToolbarSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="CommunityFeedButton" Content="Community" Click="OnCommunityClicked" Height="32" MinWidth="104" AutomationProperties.Name="Community clips" />
                <Button x:Name="MyUploadsButton" Content="My uploads" Click="OnMyUploadsClicked" Height="32" MinWidth="104" Background="Transparent" BorderBrush="Transparent" />
            </StackPanel>
            <StackPanel x:Name="FeedActionsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshFeedButton" Content="Refresh" Click="OnRefreshFeedClicked" Height="32" />
                <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Padding="0" AutomationProperties.Name="Community options" ToolTipService.ToolTip="Community options">
                    <Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="BlockedUsersButton" Text="Blocked users" Click="OnBlockedUsersClicked" /></MenuFlyout></Button.Flyout>
                </Button>
                <Button x:Name="UploadButton" Content="Upload clip" Click="OnUploadClicked" Style="{StaticResource KlippPrimaryButton}" Height="32" ToolTipService.ToolTip="Share a clip up to 60 seconds at 720p. Free beta: 5 shared clips per account." />
            </StackPanel>
        </Grid>

        <Border x:Name="UploadProgressPanel" Visibility="Collapsed" Background="{StaticResource KlippSurfaceBrush}" BorderBrush="{StaticResource KlippBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="UploadProgressTitle" Text="Uploading clip" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="UploadProgressBar" Minimum="0" Maximum="100" Value="0" Height="5" AutomationProperties.Name="Clip upload progress" />
                    <TextBlock x:Name="UploadProgressText" Text="Preparing upload…" Style="{StaticResource KlippBodyTextSecondary}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button x:Name="CancelUploadButton" Grid.Column="1" Content="Cancel" Click="OnCancelUploadClicked" Height="32" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <InfoBar x:Name="FeedNotice" IsOpen="False" Visibility="Collapsed" IsClosable="True" Closed="OnFeedNoticeClosed" Severity="Informational" AutomationProperties.LiveSetting="Polite" />

        <Border x:Name="WatchPanel" Visibility="Collapsed">
                <Grid x:Name="WatchContent" ColumnSpacing="20" RowSpacing="16" SizeChanged="OnWatchContentSizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="WatchVideoColumn" Width="*" /><ColumnDefinition x:Name="WatchCommentsColumn" Width="292" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="WatchVideoPanel" Spacing="10">
                        <Grid x:Name="OnlineVideoAnchor" Height="340" Background="Black">
                            <local:PlaybackCursorGrid x:Name="OnlineVideoSurface" Background="Black" PointerMoved="OnFullscreenPointerMoved" PointerEntered="OnFullscreenPointerMoved" SizeChanged="OnVideoSurfaceSizeChanged">
                                <Grid x:Name="OnlinePlayerHost" />
                                <Image x:Name="WatchPoster" Stretch="Uniform" IsHitTestVisible="False" />
                                <Button x:Name="WatchPlayButton" Content="Play clip" Click="OnSelectedPlayClicked" HorizontalAlignment="Center" VerticalAlignment="Center" Height="36" />
                                <Button x:Name="ExitFullscreenButton" Content="Fullscreen" Click="OnExpandVideoClicked" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Height="36" AutomationProperties.Name="Fullscreen video" ToolTipService.ToolTip="Fullscreen (F). Press Escape to return." />
                            </local:PlaybackCursorGrid>
                        </Grid>
                        <Grid x:Name="WatchHeader" ColumnSpacing="12" RowSpacing="9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="WatchTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                <TextBlock x:Name="WatchAuthor" Style="{StaticResource KlippBodyTextSecondary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="WatchActionsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                <Button x:Name="WatchLikeButton" Content="Like" Click="OnWatchLikeClicked" Height="32" />
                                <Button x:Name="ExpandVideoButton" Content="Fullscreen" Click="OnExpandVideoClicked" Height="32" AutomationProperties.Name="Fullscreen video" ToolTipService.ToolTip="Fullscreen (F). Double-click the video, or press Escape to return." />
                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Click="OnCloseWatchClicked" Height="32" Width="32" Padding="0" AutomationProperties.Name="Close video" ToolTipService.ToolTip="Close video" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="WatchDescription" Style="{StaticResource KlippBodyTextSecondary}" TextWrapping="Wrap" MaxLines="6" />
                    </StackPanel>
                    <Border x:Name="CommentsPanel" Grid.Column="1" Padding="14" Background="{StaticResource KlippSurfaceBrush}" BorderBrush="{StaticResource KlippBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Top">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="CommentsHeading" Text="Comments" FontSize="14" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="3" Spacing="8">
                            <TextBox x:Name="CommentInput" PlaceholderText="Add a comment" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Comment on this clip" />
                            <Button x:Name="PostCommentButton" Content="Post comment" Click="OnPostCommentClicked" Height="32" HorizontalAlignment="Right" />
                        </StackPanel>
                        <ScrollViewer x:Name="CommentsScroll" Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="CommentsStateText" Text="Loading comments…" Style="{StaticResource KlippBodyTextSecondary}" />
                                <ItemsControl ItemsSource="{x:Bind Comments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:CommunityCommentItem">
                                            <Border BorderBrush="{StaticResource KlippBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Author}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Content="Delete" Tag="{x:Bind}" Click="OnDeleteCommentClicked" Visibility="{x:Bind DeleteVisibility}" Height="28" MinHeight="28" Padding="6,2" FontSize="11" AutomationProperties.Name="Delete your comment" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Body}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind CreatedLabel}" Style="{StaticResource KlippCaption}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="OlderCommentsButton" Grid.Row="2" Content="Load older comments" Click="OnOlderCommentsClicked" Height="30" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                    </Grid>
                    </Border>
                </Grid>
        </Border>

        <Grid x:Name="BrowseHeader" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="BrowseHeading" Text="Latest clips" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="BrowseCount" Grid.Column="1" Style="{StaticResource KlippCaption}" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="FeedLoadingPanel" Visibility="Collapsed" ColumnSpacing="10" HorizontalAlignment="Center" Margin="0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressRing x:Name="FeedProgress" IsActive="False" Width="20" Height="20" />
            <TextBlock Grid.Column="1" Text="Loading clips…" Style="{StaticResource KlippBodyTextSecondary}" VerticalAlignment="Center" />
        </Grid>

        <Border x:Name="FeedEmptyPanel" Visibility="Collapsed" Background="{StaticResource KlippSurfaceBrush}" BorderBrush="{StaticResource KlippBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="28">
            <StackPanel Spacing="12" MaxWidth="420" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE714;" FontSize="28" Foreground="{StaticResource KlippTextMutedBrush}" HorizontalAlignment="Left" />
                <TextBlock x:Name="FeedEmptyTitle" Text="No clips shared yet" Style="{StaticResource KlippHeadingMedium}" TextWrapping="Wrap" />
                <TextBlock x:Name="FeedEmptyDescription" Text="Share a highlight from your Library to start the community." Style="{StaticResource KlippBodyTextSecondary}" />
                <Button Content="Choose a local clip" Click="OnUploadClicked" HorizontalAlignment="Left" Height="32" />
            </StackPanel>
        </Border>

        <ItemsRepeater x:Name="ClipRepeater" ItemsSource="{x:Bind Clips}">
            <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="244" MinRowSpacing="14" MinColumnSpacing="14" MaximumRowsOrColumns="3" ItemsStretch="Fill" /></ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:CommunityFeedClipItem">
                    <Border Tag="{x:Bind}" EffectiveViewportChanged="OnClipViewportChanged" Background="{x:Bind CardBackground, Mode=OneWay}" BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="0">
                            <Button Click="OnWatchClipClicked" Tag="{x:Bind}" IsEnabled="{x:Bind CanPlay, Mode=OneWay}" Padding="0" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind WatchLabel, Mode=OneWay}">
                                <Grid Height="160" SizeChanged="OnClipPosterSizeChanged" Background="{StaticResource KlippBackgroundBrush}">
                                    <FontIcon Glyph="&#xE714;" FontSize="26" Foreground="{StaticResource KlippTextMutedBrush}" />
                                    <Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill" ImageFailed="OnPosterFailed" />
                                    <Border Background="#CF17191C" Padding="7,3" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"><TextBlock Text="{x:Bind DurationLabel}" FontSize="11" FontFamily="{StaticResource KlippFontFamilyMono}" /></Border>
                                    <Border Background="#C0202327" Width="36" Height="36" CornerRadius="18"><FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" /></Border>
                                    <Border Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" Background="{StaticResource KlippAccentPressedBrush}" Padding="7,3" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"><TextBlock Text="Selected" FontSize="11" FontWeight="SemiBold" /></Border>
                                </Grid>
                            </Button>
                            <StackPanel Padding="12" Spacing="8">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Author}" Style="{StaticResource KlippBodyTextSecondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CreatedLabel}" Style="{StaticResource KlippCaption}" />
                                </Grid>
                                <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" Visibility="{x:Bind StateVisibility, Mode=OneWay}" Style="{StaticResource KlippBodyTextSecondary}" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button Content="{x:Bind LikeLabel, Mode=OneWay}" Tag="{x:Bind}" Click="OnLikeClicked" IsEnabled="{x:Bind CanPlay, Mode=OneWay}" Height="30" MinHeight="30" Padding="7,3" FontSize="11" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="{x:Bind CommentsLabel, Mode=OneWay}" Tag="{x:Bind}" Click="OnCommentsClicked" IsEnabled="{x:Bind CanPlay, Mode=OneWay}" Height="30" MinHeight="30" Padding="7,3" FontSize="11" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="2" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Height="30" MinHeight="30" Width="30" Padding="0" AutomationProperties.Name="Clip actions">
                                        <Button.Flyout><MenuFlyout>
                                            <MenuFlyoutItem Text="Delete shared clip" Tag="{x:Bind}" Click="OnDeleteClipClicked" Visibility="{x:Bind OwnVisibility}" />
                                            <MenuFlyoutItem Text="Report clip" Tag="{x:Bind}" Click="OnReportClipClicked" Visibility="{x:Bind OtherVisibility}" />
                                            <MenuFlyoutItem Text="Block this user" Tag="{x:Bind}" Click="OnBlockUserClicked" Visibility="{x:Bind OtherVisibility}" />
                                        </MenuFlyout></Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Grid x:Name="FeedPagingPanel" Visibility="Collapsed" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="NewerPageButton" Content="Newer clips" Click="OnNewerPageClicked" Height="32" />
            <TextBlock x:Name="FeedPageText" Grid.Column="1" Text="Page 1" Style="{StaticResource KlippBodyTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Name="OlderPageButton" Grid.Column="2" Content="Older clips" Click="OnOlderPageClicked" Height="32" />
        </Grid>
    </StackPanel>
</UserControl>
