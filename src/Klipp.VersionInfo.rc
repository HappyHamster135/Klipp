#include <windows.h>
#include "Klipp.Version.generated.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION KLIPP_VERSION_NUMERIC
 PRODUCTVERSION KLIPP_VERSION_NUMERIC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", KLIPP_FILE_DESCRIPTION "\0"
            VALUE "FileVersion", KLIPP_FILE_VERSION "\0"
            VALUE "OriginalFilename", KLIPP_ORIGINAL_FILENAME "\0"
            VALUE "ProductName", "Klipp\0"
            VALUE "ProductVersion", KLIPP_PRODUCT_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
