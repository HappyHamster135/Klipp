<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);FX_PREVIEW_HARNESS</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>../../src/Klipp.Desktop/app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.2.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <ProjectReference Include="../../src/Klipp.Core/Klipp.Core.csproj" />
    <ProjectReference Include="../../src/Klipp.Capture/Klipp.Capture.csproj" />
    <Compile Include="../../src/Klipp.Desktop/Models/EditorProject.cs" Link="Models/EditorProject.cs" />
    <Compile Include="../../src/Klipp.Desktop/Models/EditorProjectEffectLayer.cs" Link="Models/EditorProjectEffectLayer.cs" />
    <Compile Include="../../src/Klipp.Desktop/Models/EditorTextTypography.cs" Link="Models/EditorTextTypography.cs" />
    <Compile Include="../../src/Klipp.Desktop/Controls/SafeClipEditorView.FrameEffects.cs" Link="Renderer/FrameEffects.cs" />
    <Compile Include="../../src/Klipp.Desktop/Controls/SafeClipEditorView.FrameLut.cs" Link="Renderer/FrameLut.cs" />
    <Compile Include="../../src/Klipp.Desktop/Controls/SafeClipEditorView.FramePreview.cs" Link="Renderer/FramePreview.cs" />
    <Compile Include="../../src/Klipp.Desktop/Controls/SafeClipEditorView.TimelineEffectPreview.cs" Link="Renderer/TimelineEffectPreview.cs" />
    <Compile Include="../../src/Klipp.Desktop/Controls/SafeClipEditorView.TimelineEffectMask.cs" Link="Renderer/TimelineEffectMask.cs" />
    <Compile Include="../../src/Klipp.Desktop/CaptureNotificationWindow.cs" Link="Notifications/CaptureNotificationWindow.cs" />
    <Compile Include="../../src/Klipp.Desktop/Controls/KlippBrandMark.cs" Link="Notifications/KlippBrandMark.cs" />
    <Compile Include="../../src/Klipp.Desktop/CaptureNotificationOverlay.cs" Link="Notifications/CaptureNotificationOverlay.cs" />
    <Compile Include="../../src/Klipp.Desktop/Services/CaptureNotificationService.cs" Link="Notifications/CaptureNotificationService.cs" />
    <Compile Include="../../src/Klipp.Desktop/Services/CaptureGameNotificationPresenter.cs" Link="Notifications/CaptureGameNotificationPresenter.cs" />
    <Compile Include="../../src/Klipp.Desktop/Services/CaptureNotificationContext.cs" Link="Notifications/CaptureNotificationContext.cs" />
    <Compile Include="../../src/Klipp.Desktop/Services/TrayIconService.cs" Link="Tray/TrayIconService.cs" />
    <Compile Include="../../src/Klipp.Desktop/Services/AppInstanceCoordinator.cs" Link="Tray/AppInstanceCoordinator.cs" />
    <Compile Include="../../src/Klipp.Desktop/Services/HotkeyManager.cs" Link="Tray/HotkeyManager.cs" />
  </ItemGroup>
</Project>
